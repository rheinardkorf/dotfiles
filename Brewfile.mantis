# Extra packages for mantis (work Mac), on top of Brewfile.core.
# bootstrap.sh installs whatever is missing from Brewfile.<machine-name>, never upgrading.
# Only brew/cask entries; npm/go globals and VS Code extensions are managed elsewhere.

tap "anthropics/tap"
tap "atlassian/acli", trusted: true
tap "mongodb/brew", trusted: true
tap "oven-sh/bun", trusted: true

brew "aws-sam-cli"
brew "cmake"
brew "curl"
brew "libpq", link: true
brew "php"
brew "composer"
brew "docker"
brew "docker-compose"
brew "ffmpeg"
brew "gcc"
brew "jira-cli"
brew "ldns"
brew "llama.cpp"
brew "mysql"
brew "nushell"
brew "openssh"
brew "p7zip"
brew "pdm"
brew "poppler"
brew "python@3.11"
brew "qpdf"
brew "sops"
brew "taplo"
brew "xcodegen"
brew "atlassian/acli/acli", trusted: true
brew "mongodb/brew/mongodb-database-tools", trusted: true
brew "oven-sh/bun/bun", trusted: true

cask "anthropics/tap/ant", trusted: true
cask "cursor"
cask "dbeaver-community"
cask "docker-desktop"
cask "font-sf-pro"
cask "gcloud-cli"
cask "google-chrome"
cask "ollama-app"
cask "postman"
cask "qlmarkdown"
cask "sf-symbols"
cask "tunnelblick"
cask "visual-studio-code"
