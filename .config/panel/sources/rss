#!/usr/bin/env python3
"""panel source: RSS and Atom feeds.

    rss fetch '<feeds>'     the articles of these feeds, newest first
    rss preview <id>        an article as Markdown (from the feed, cached)
    rss search <words>      "<id>\t<snippet>" for cached articles whose title or
                            summary has all the words
    rss summary <view>      the HUD's line and briefing sentences for a category,
                            from the facts on stdin (JSON)
    rss action later <id> on|off   saved for later (alt-r): keep a copy of the
                            article (and its picture) so it outlives its feed

The query is the pane's (or view's) list of feeds, as JSON: URLs, or
{"url": ..., "name": ...} to choose the short name shown in the list. A pane
with views makes each view a category:

    "views": {"tech": ["https://lobste.rs/rss", ...], "security": [...]}

Feeds are fetched in parallel with conditional requests (ETag / Last-Modified),
so an unchanged feed costs almost nothing. Only the feeds are read, never the
article pages. Each feed keeps its last 50 articles (at most 30 days old).
Every article is new (●) until you've looked at it.

Images: each new article's picture is saved in the cache (as JPEG, at most
800px, through macOS sips), from the feed's media tags or enclosure, else the
first image in its text, else the article page's og:image (the one time a page
is read: its head, once per article). The preview starts with
"<!-- panel:image <path> -->" for panel to draw it.

Sparse articles (a link and little else, like Hacker News and Lobsters items):
their page is read once at fetch time for its description (og:description) and
the opening of the article itself (readable text, extracted with trafilatura
through uv), so the preview says what it's about.
"""
import subprocess
import concurrent.futures
import email.utils
import hashlib
import html
import html.parser
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timezone

CACHE = os.environ.get("PANEL_SOURCE_CACHE") or sys.exit("rss: run me through panel")
FEEDS = os.path.join(CACHE, "feeds")
KEEP, KEEP_DAYS = 50, 30
IMAGES = os.path.join(CACHE, "images")
SAVED = os.path.join(CACHE, "saved.json")
PAGES = os.path.join(CACHE, "pages")        # article pages, only while being read   # articles saved for later: {id: article + feed}
IMAGE_JOBS = 60          # at most this many image lookups per fetch (the rest wait)
IMAGE_MAX = 8_000_000    # bytes
SPARSE = 200             # feed text shorter than this (characters) gets its page read
PAGE_JOBS = 40           # at most this many pages read per fetch (the rest wait)
PAGE_MAX = 2_000_000     # bytes
OPENING = 1500           # characters of the article kept for the preview
EXTRACT = """
import json, sys, trafilatura
out = {}
for aid, (path, url) in json.load(open(sys.argv[1])).items():
    try:
        out[aid] = trafilatura.extract(open(path, encoding="utf-8", errors="replace").read(), url=url,
                                       include_comments=False, include_tables=False, favor_precision=True) or ""
    except Exception:
        out[aid] = ""
json.dump(out, sys.stdout)
"""
UA = "panel-rss/1.0 (+https://github.com/rheinardkorf/dotfiles)"

NS = {"atom": "http://www.w3.org/2005/Atom", "content": "http://purl.org/rss/1.0/modules/content/",
      "dc": "http://purl.org/dc/elements/1.1/", "rss1": "http://purl.org/rss/1.0/",
      "media": "http://search.yahoo.com/mrss/"}
IMG_SRC = re.compile(r"<img[^>]+src=[\"']([^\"']+)", re.I)


def image_of(e, body):
    """An entry's picture: media tags or an image enclosure, else the first <img> in its text."""
    for el in e.iter():
        tag = el.tag.split("}")[-1]
        url, typ = el.get("url") or el.get("href"), (el.get("type") or "")
        if not url:
            continue
        if tag == "thumbnail" or (tag == "content" and (el.get("medium") == "image" or typ.startswith("image/"))):
            return url
        if (tag == "enclosure" or (tag == "link" and el.get("rel") == "enclosure")) and typ.startswith("image/"):
            return url
    m = IMG_SRC.search(body or "")
    return html.unescape(m[1]) if m else None


def sha(s, n=16):
    return hashlib.sha1(s.encode()).hexdigest()[:n]


def epoch(s):
    """RFC 822 (RSS) or ISO 8601 (Atom) -> epoch seconds, or None."""
    if not s:
        return None
    s = s.strip()
    try:
        return int(email.utils.parsedate_to_datetime(s).timestamp())
    except (TypeError, ValueError, IndexError):
        pass
    try:
        d = datetime.fromisoformat(s.replace("Z", "+00:00"))
        return int((d if d.tzinfo else d.replace(tzinfo=timezone.utc)).timestamp())
    except ValueError:
        return None


def text(el):
    return (el.text or "").strip() if el is not None else ""


def parse(data):
    """Feed bytes -> (title, [entries]); entries: {id, title, link, published, author, summary}."""
    root = ET.fromstring(data)
    tag = root.tag.split("}")[-1]
    entries = []
    if tag == "feed":   # Atom
        title = text(root.find("atom:title", NS))
        for e in root.findall("atom:entry", NS):
            link = next((l.get("href") for l in e.findall("atom:link", NS) if l.get("rel", "alternate") == "alternate"), None)
            content = e.find("atom:content", NS)
            if content is None:
                content = e.find("atom:summary", NS)
            entries.append({"id": text(e.find("atom:id", NS)) or link, "title": text(e.find("atom:title", NS)), "link": link,
                            "published": epoch(text(e.find("atom:published", NS)) or text(e.find("atom:updated", NS))),
                            "author": text(e.find("atom:author/atom:name", NS)), "summary": text(content),
                            "image_url": image_of(e, text(content))})
    else:               # RSS 2.0 (channel/item) or RSS 1.0 (rdf:RDF/item)
        channel = root.find("channel")
        title = text(channel.find("title")) if channel is not None else text(root.find("rss1:channel/rss1:title", NS))
        items = (channel.findall("item") if channel is not None else []) or root.findall("rss1:item", NS)
        for e in items:
            def f(name):
                return e.find(name) if e.find(name) is not None else e.find(f"rss1:{name}", NS)
            link = text(f("link"))
            body = text(e.find("content:encoded", NS)) or text(f("description"))
            entries.append({"id": text(e.find("guid")) or link or text(f("title")), "title": text(f("title")), "link": link,
                            "published": epoch(text(e.find("pubDate")) or text(e.find("dc:date", NS))),
                            "author": text(e.find("dc:creator", NS)) or text(e.find("author")), "summary": body,
                            "image_url": image_of(e, body)})
    return title, entries


def feed_file(url):
    return os.path.join(FEEDS, sha(url) + ".json")


def load(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return default


def save(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, path)


def update(feed):
    """Fetch one feed (conditionally) and merge its entries into its cache file."""
    url, now = feed["url"], int(time.time())
    path = feed_file(url)
    st = load(path, {"url": url, "articles": {}, "first_fetch": None})
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/rss+xml, application/atom+xml, application/xml, text/xml, */*"})
    if st.get("etag"):
        req.add_header("If-None-Match", st["etag"])
    if st.get("modified"):
        req.add_header("If-Modified-Since", st["modified"])
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            data, etag, modified = r.read(), r.headers.get("ETag"), r.headers.get("Last-Modified")
    except urllib.error.HTTPError as e:
        if e.code == 304:   # unchanged
            st["checked"] = now
            save(path, st)
            return st, None
        return st, f"{feed.get('name') or url}: HTTP {e.code}"
    except Exception as e:
        return st, f"{feed.get('name') or url}: {getattr(e, 'reason', e)}"
    try:
        title, entries = parse(data)
    except ET.ParseError as e:
        return st, f"{feed.get('name') or url}: not a feed ({e})"
    st.update(title=title, etag=etag, modified=modified, checked=now)
    arts = st["articles"]
    for e in entries:
        if not e["id"]:
            continue
        aid = sha(url + "\n" + e["id"])
        old = arts.get(aid, {})
        e["first_seen"] = old.get("first_seen", now)
        for k in ("image", "image_tried", "page_tried", "description", "opening"):   # found (or looked for) once, kept
            if k in old:
                e[k] = old[k]
        e["summary"] = e["summary"][:20000]
        arts[aid] = e
    # keep the newest KEEP, none older than KEEP_DAYS
    cutoff = now - KEEP_DAYS * 86400
    keep = sorted(arts.items(), key=lambda kv: -(kv[1].get("published") or kv[1]["first_seen"]))
    st["articles"] = dict(kv for kv in keep[:KEEP] if (kv[1].get("published") or kv[1]["first_seen"]) >= cutoff)
    save(path, st)
    return st, None


def short(title, url):
    t = re.split(r"\s+[-–—|:]\s+", title or "")[0].strip() or re.sub(r"^www\.", "", urllib.parse.urlparse(url).netloc)
    return t.lower()[:22]


OG = re.compile(r"""<meta[^>]+(?:property|name)=["'](?:og:image|twitter:image)(?::src)?["'][^>]*>""", re.I)
CONTENT = re.compile(r"""content=["']([^"']+)""", re.I)


def get(url, limit):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=15) as r:
        return r.read(limit + 1), r.geturl()


def find_image(job):
    """(feed path, article id, image url or None, article link, text) -> saved jpg path or None."""
    path, aid, url, link, body = job
    try:
        if not url:   # the article's own text (articles cached before images were kept)
            m = IMG_SRC.search(body or "")
            url = html.unescape(m[1]) if m else None
        if not url and link:   # the page's og:image: only its head is read
            page, final = get(link, 300_000)
            m = OG.search(page.decode("utf-8", "replace"))
            c = CONTENT.search(m[0]) if m else None
            url = urllib.parse.urljoin(final, html.unescape(c[1])) if c else None
        if not url:
            return None
        data, _ = get(urllib.parse.urljoin(link or "", url), IMAGE_MAX)
        if len(data) > IMAGE_MAX:
            return None
        raw, jpg = os.path.join(IMAGES, aid + ".raw"), os.path.join(IMAGES, aid + ".jpg")
        with open(raw, "wb") as fh:
            fh.write(data)
        ok = subprocess.run(["sips", "-s", "format", "jpeg", "-s", "formatOptions", "80", "-Z", "800", raw, "--out", jpg],
                            capture_output=True, timeout=30).returncode == 0
        os.unlink(raw)
        return jpg if ok and os.path.exists(jpg) else None
    except Exception:
        return None


DESC = re.compile(r"""<meta[^>]+(?:property|name)=["'](?:og:description|twitter:description|description)["'][^>]*>""", re.I)


def opening(text):
    """The article's first paragraphs, up to OPENING characters, cut at a paragraph."""
    out, n = [], 0
    for para in [p.strip() for p in (text or "").split("\n") if p.strip()]:
        if n and n + len(para) > OPENING:
            break
        out.append(para[:OPENING])
        n += len(para)
    return "\n\n".join(out)


def read_page(job):
    """(article id, link) -> (id, description, html file or None, final url)."""
    aid, link = job
    try:
        page, final = get(link, PAGE_MAX)
        doc = page.decode("utf-8", "replace")
        m = DESC.search(doc[:300_000])
        c = CONTENT.search(m[0]) if m else None
        path = os.path.join(PAGES, aid + ".html")
        with open(path, "w") as fh:
            fh.write(doc)
        return aid, html.unescape(c[1]).strip() if c else "", path, final
    except Exception:
        return aid, "", None, link


def enrich(paths):
    """Sparse articles: read their page once for its description and opening."""
    jobs, where = [], {}
    for path in paths:
        for aid, a in load(path, {}).get("articles", {}).items():
            if not a.get("page_tried") and a.get("link") and len(plain(a.get("summary"))) < SPARSE:
                jobs.append((aid, a["link"]))
                where[aid] = path
    jobs = jobs[:PAGE_JOBS]
    if not jobs:
        return
    os.makedirs(PAGES, exist_ok=True)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        pages = list(pool.map(read_page, jobs))
    # the readable text of every page at once (one uv start)
    texts = {}
    todo = {aid: (path, url) for aid, _, path, url in pages if path}
    if todo:
        spec = os.path.join(PAGES, "jobs.json")
        with open(spec, "w") as fh:
            json.dump(todo, fh)
        try:
            r = subprocess.run(["uv", "run", "-q", "--no-project", "--python", "3.12", "--with", "trafilatura",
                                "python", "-I", "-c", EXTRACT, spec], capture_output=True, text=True, timeout=180)
            texts = json.loads(r.stdout) if r.returncode == 0 else {}
        except Exception:
            texts = {}
    for name in os.listdir(PAGES):   # the pages themselves aren't kept
        os.unlink(os.path.join(PAGES, name))
    by_path = {}
    for aid, desc, _, _ in pages:
        by_path.setdefault(where[aid], []).append((aid, desc))
    for path, res in by_path.items():
        st = load(path, {})
        for aid, desc in res:
            if aid in st.get("articles", {}):
                st["articles"][aid].update(page_tried=True, description=desc, opening=opening(texts.get(aid)))
        save(path, st)


def images(paths):
    """Look up pictures for articles that haven't been tried, then drop unused ones."""
    os.makedirs(IMAGES, exist_ok=True)
    jobs = []
    for path in paths:
        st = load(path, {})
        for aid, a in st.get("articles", {}).items():
            if not a.get("image_tried"):
                jobs.append((path, aid, a.get("image_url"), a.get("link"), a.get("summary")))
    jobs.sort(key=lambda j: j[2] is None)   # cheap ones (url known) first
    jobs = jobs[:IMAGE_JOBS]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        found = list(pool.map(find_image, jobs))
    by_path = {}
    for (path, aid, _, _, _), png in zip(jobs, found):
        by_path.setdefault(path, {})[aid] = png
    for path, res in by_path.items():
        st = load(path, {})
        for aid, png in res.items():
            if aid in st.get("articles", {}):
                st["articles"][aid].update(image_tried=True, image=png)
        save(path, st)
    # drop pictures no feed (in any view) or saved article still has
    used = {a.get("image") for f in all_feeds() for a in load(f, {}).get("articles", {}).values()}
    used |= {a.get("image") for a in load(SAVED, {}).values()}
    for name in os.listdir(IMAGES):
        if os.path.join(IMAGES, name) not in used:
            os.unlink(os.path.join(IMAGES, name))


def all_feeds():
    return [os.path.join(FEEDS, n) for n in os.listdir(FEEDS)] if os.path.isdir(FEEDS) else []


def fetch(query):
    try:
        feeds = json.loads(query) if query.strip() else []
    except json.JSONDecodeError:
        feeds = [query.strip()]
    feeds = [f if isinstance(f, dict) else {"url": f} for f in feeds if f]
    if not feeds:
        sys.exit("rss: no feeds configured for this view (put them in config.local.json)")
    os.makedirs(FEEDS, exist_ok=True)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(update, feeds))
    errors = [err for _, err in results if err]
    enrich([feed_file(f["url"]) for f in feeds])
    images([feed_file(f["url"]) for f in feeds])
    results = [(load(feed_file(f["url"]), st), err) for f, (st, err) in zip(feeds, results)]
    items = []
    for feed, (st, _) in zip(feeds, results):
        name = feed.get("name") or short(st.get("title"), feed["url"])
        for aid, a in st.get("articles", {}).items():
            when = a.get("published") or a["first_seen"]
            # updated never changes: an article is new until looked at, then seen for good
            items.append({"id": aid, "key": "", "status": name, "title": html.unescape(a["title"] or "(untitled)"),
                          "url": a.get("link"), "updated": when})
    for err in errors:
        print(err, file=sys.stderr)
    if errors and len(errors) == len(feeds):
        sys.exit(1)
    items.sort(key=lambda i: -i["updated"])
    json.dump(items, sys.stdout)


class Text(html.parser.HTMLParser):
    """HTML -> plain text with paragraphs, list items and link targets."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.href = [], None

    def handle_starttag(self, tag, attrs):
        if tag in ("p", "div", "br", "h1", "h2", "h3", "h4", "blockquote", "tr"):
            self.out.append("\n\n" if tag != "br" else "\n")
        elif tag == "li":
            self.out.append("\n- ")
        elif tag == "a":
            self.href = dict(attrs).get("href")

    def handle_endtag(self, tag):
        if tag == "a":
            self.href = None

    def handle_data(self, data):
        self.out.append(data)
        if self.href and data.strip() and self.href not in data:
            self.out.append(f" ({self.href})")
            self.href = None

    def result(self):
        s = re.sub(r"[ \t]+", " ", "".join(self.out))
        return re.sub(r"\n\s*\n\s*(\n\s*)+", "\n\n", s).strip()


def plain(s):
    p = Text()
    p.feed(s or "")
    return p.result()


def articles():
    """Every cached article: the feeds', then saved ones no longer in a feed."""
    seen = set()
    for name in os.listdir(FEEDS) if os.path.isdir(FEEDS) else []:
        st = load(os.path.join(FEEDS, name), {})
        for aid, a in st.get("articles", {}).items():
            seen.add(aid)
            yield aid, a, st
    for aid, a in load(SAVED, {}).items():
        if aid not in seen:
            yield aid, a, {"title": a.get("feed_title"), "url": a.get("feed_url", "")}


def action(tag, aid, state):
    """later on: keep a copy of the article; off: let it go."""
    if tag != "later":
        return
    saved = load(SAVED, {})
    if state == "off":
        saved.pop(aid, None)
    elif aid not in saved:
        for i, a, st in articles():
            if i == aid:
                saved[aid] = dict(a, feed_title=st.get("title"), feed_url=st.get("url"), saved_at=int(time.time()))
                break
    os.makedirs(CACHE, exist_ok=True)
    save(SAVED, saved)


def preview(aid):
    for i, a, st in articles():
        if i == aid:
            when = a.get("published") or a["first_seen"]
            if a.get("image") and os.path.exists(a["image"]):
                print(f"<!-- panel:image {a['image']} -->")
            print(f"# {html.unescape(a['title'] or '(untitled)')}\n")
            by = f" · {a['author']}" if a.get("author") else ""
            print(f"**{st.get('title') or st['url']}**{by} · {time.strftime('%a %-d %b %H:%M', time.localtime(when))}  ")
            if a.get("link"):
                print(f"{a['link']}\n")
            body = plain(a.get("summary"))
            if len(body) < SPARSE and (a.get("description") or a.get("opening")):
                # a sparse feed entry: what the page says about itself, then its opening
                if a.get("description"):
                    print(f"_{a['description']}_\n")
                if a.get("opening"):
                    print("## From the article\n")
                    print(a["opening"] + "\n")
                if body:
                    print(f"---\n\n{body}")
                return
            print(body[:6000] + ("…" if len(body) > 6000 else "") if body else "_No summary in the feed: ctrl-o opens the article._")
            return
    print("This article is no longer in the cache.")


def search(words):
    words = [w for w in words.lower().split() if w]
    for aid, a, _ in articles():
        txt = re.sub(r"\s+", " ", f"{a['title']}  {plain(a.get('summary'))}  {a.get('description') or ''}  {a.get('opening') or ''}")
        low = txt.lower()
        if words and all(w in low for w in words):
            i = low.index(words[0])
            print(f"{aid}\t{txt[max(0, i - 40):i + 70]}".replace("\n", " "))


WORDS = "no one two three four five six seven eight nine ten eleven twelve".split()


def count(n, one, many):
    return f"{WORDS[n] if 0 <= n < len(WORDS) else n} {one if n == 1 else many}"


def pane_summary(f):
    """All categories at once (pane mode): one line, one short sentence."""
    new = [(v["view"], v.get("unseen", 0)) for v in f["views"] if v["view"] != "later" and v.get("unseen")]
    later = next((v.get("count", 0) for v in f["views"] if v["view"] == "later"), 0)
    bits = [f"{n} new in {v}" for v, n in new] + ([f"{later} saved for later"] if later else [])
    if not bits:
        return {"word": "synced"}
    out = {"line": " · ".join(bits), "word": "synced"}
    def listed(parts):
        return parts[0] if len(parts) == 1 else ", ".join(parts[:-1]) + " and " + parts[-1]
    total = sum(n for _, n in new)
    saved = f"{count(later, 'article', 'articles')} saved for later" if later else ""
    if new:
        where = listed([f"{WORDS[n] if n < len(WORDS) else n} in {v}" for v, n in new])
        plus = f", plus {WORDS[later] if later < len(WORDS) else later} saved for later" if later else ""
        out["brief"] = [f"New reading: {where}{plus}.",
                        f"{count(total, 'new article', 'new articles').capitalize()} in your feeds{plus}.",
                        f"{where.capitalize()} to read{plus}."]
    else:
        out["brief"] = [f"{saved.capitalize()}.", f"Your reading list has {count(later, 'article', 'articles')}."]
    return out


def summary(view):
    f = json.load(sys.stdin)
    if f.get("pane"):
        return print(json.dumps(pane_summary(f)))
    if view == "later":   # the reading list: how long it is, not what's new
        n = f.get("count", 0)
        if not n:
            return print(json.dumps({}))
        return print(json.dumps({"line": f"{n} saved for later", "brief": [
            f"{count(n, 'article', 'articles').capitalize()} saved for later.",
            f"You have {count(n, 'article', 'articles')} waiting to be read.",
            f"Your reading list has {count(n, 'article', 'articles')}."]}))
    where, n = view or "your feeds", f.get("unseen", 0)
    if not n:   # all read: nothing to say (the total isn't news)
        return print(json.dumps({"word": "synced"}))
    print(json.dumps({"line": f"{n} new in {where}", "word": "synced", "brief": [
        f"{count(n, 'new article', 'new articles').capitalize()} in {where}.",
        f"{where.capitalize()} has {count(n, 'new read', 'new reads')}.",
        f"{count(n, 'new story', 'new stories').capitalize()} in {where}."]}))


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    arg = sys.argv[2] if len(sys.argv) > 2 else ""
    if cmd == "fetch":
        fetch(arg)
    elif cmd == "preview":
        preview(arg)
    elif cmd == "search":
        search(arg)
    elif cmd == "summary":
        summary(arg)
    elif cmd == "action":
        action(arg, sys.argv[3] if len(sys.argv) > 3 else "", sys.argv[4] if len(sys.argv) > 4 else "")
    else:
        sys.exit("usage: rss fetch '<feeds json>' | rss preview <id> | rss search <words>")
