#!/usr/bin/env zsh
# panel source: Jira, through Atlassian's acli (log in once: acli jira auth login).
#
#   jira fetch <jql>     list the tickets, and refresh the cached details
#                        (fields + comments) of new or changed ones
#   jira preview <key>   the ticket, its request fields and comments as Markdown,
#                        from the cache
#   jira search <words>  "<key>\t<snippet>" for cached tickets whose summary,
#                        description, fields or comments contain all the words
#
# Config (.sources.jira in panel's config.json), all optional:
#   site    Atlassian site for links (default: the one acli is logged in to)
#   labels  {"customfield_10325": "Justification", ...}: request fields to show
#           first, in this order. acli can't list field names, so name them here.
#   hide    ["customfield_11154", ...]: fields to leave out of "Other fields"
#   other   false: don't list unlabelled fields at all
emulate -L zsh
setopt extendedglob pipefail
zmodload zsh/datetime
path=(/opt/homebrew/bin $path)

cache="${PANEL_SOURCE_CACHE:?run me through panel}"
items="$cache/items"
conf="$PANEL_SOURCE_CONFIG"
[[ -n $conf ]] || conf='{}'

fetch() {
  local jql=$1 base list site details mins
  local -a keys changed need files
  mkdir -p $items
  # Same search, only what changed since the last good fetch. Comes before the
  # list, so nothing that changes in between is missed.
  base=${jql%%(#i)[[:space:]]##order[[:space:]]##by[[:space:]]*}
  if [[ -n $PANEL_SINCE ]]; then
    mins=$(( (EPOCHSECONDS - PANEL_SINCE) / 60 + 2 ))
    changed=( ${(f)"$(acli jira workitem search --jql "($base) AND updated >= -${mins}m" \
      --fields key --paginate --json | jq -r '.[].key')"} ) || return 1
  fi
  list="$(acli jira workitem search --jql "$jql" --fields 'key,summary,status,priority,issuetype' \
    --paginate --json)" || { print -u2 -r -- "$list"; return 1 }
  keys=( ${(f)"$(jq -r '.[].key' <<<"$list")"} ) || return 1

  # Details: new tickets, changed ones, and all of them on a pane's first fetch.
  for k in $keys; do
    if [[ -z $PANEL_SINCE || ! -f $items/$k.json ]] || (( ${changed[(Ie)$k]} )); then
      need+=$k
    else
      touch $items/$k.json   # still listed: keep it from being pruned
    fi
  done
  if (( $#need )); then
    print -rl -- $need | xargs -P 4 -n 1 zsh -c '
      tmp="$(mktemp "$1/.$2.XXXX")"
      if acli jira workitem view "$2" --fields "*all" --json > "$tmp" 2>/dev/null &&
         jq -e .key "$tmp" >/dev/null 2>&1; then mv "$tmp" "$1/$2.json"
      else rm -f "$tmp"; print -u2 "no details for $2"; fi' _ $items
  fi
  find $items -name '*.json' -mtime +14 -delete 2>/dev/null

  site="$(jq -r '.site // empty' <<<"$conf")"
  if [[ -z $site ]]; then
    [[ -s $cache/site ]] || acli jira auth status 2>/dev/null | sed -n 's/^ *Site: *//p' > $cache/site
    site="$(<$cache/site)"
  fi
  files=( $items/${^keys}.json(N) )
  if (( $#files )); then
    details="$(jq -sc 'map({key: .key, value: .fields.updated}) | from_entries' $files)"
  else
    details='{}'
  fi
  jq --argjson d "$details" --arg site "$site" '
    def epoch: if . == null then null else (.[0:19] + "Z" | fromdateiso8601)
      - ((if .[-5:-4] == "-" then -1 else 1 end) * ((.[-4:-2] | tonumber) * 3600 + (.[-2:] | tonumber) * 60)) end;
    map({id: .key, title: .fields.summary, status: .fields.status.name,
         updated: ($d[.key] | epoch),
         url: (if $site != "" then "https://\($site)/browse/\(.key)" else null end)})' <<<"$list"
}

preview() {
  local f="$items/$1.json"
  if [[ ! -f $f ]]; then
    print "No details cached for **$1** yet: they arrive with the next fetch."
    return
  fi
  jq -r --argjson conf "$conf" '
    def rtrim: sub("\\s+$"; "");
    def epoch: (.[0:19] + "Z" | fromdateiso8601)
      - ((if .[-5:-4] == "-" then -1 else 1 end) * ((.[-4:-2] | tonumber) * 3600 + (.[-2:] | tonumber) * 60));
    def when: if . == null then "?" else epoch | strflocaltime("%a %-d %b %H:%M") end;
    # one line of a table cell / list item
    def oneline: gsub("\\s*\n\\s*"; " ") | gsub("\\|"; "\\|");

    # Atlassian Document Format (rich text) -> Markdown
    def adf:
      def kids: (.content // []) | map(adf) | join("");
      def marked($t): reduce (.marks // [])[] as $m ($t;
          if $m.type == "strong" then "**\(.)**" elif $m.type == "em" then "*\(.)*"
          elif $m.type == "code" then "`\(.)`" elif $m.type == "strike" then "~~\(.)~~"
          elif $m.type == "link" then "[\(.)](\($m.attrs.href))" else . end);
      def indent($p): split("\n") | map(if . == "" then . else $p + . end) | join("\n");
      def item($bullet): kids | rtrim | indent("   ") | $bullet + .[3:] + "\n";
      if type == "array" then map(adf) | join("")
      elif type != "object" then (. // "" | tostring)
      elif .type == "text" then marked(.text // "")
      elif .type == "hardBreak" then "  \n"
      elif .type == "mention" then "**\(.attrs.text // "@someone")**"
      elif .type == "emoji" then (.attrs.text // .attrs.shortName // "")
      elif .type == "inlineCard" or .type == "blockCard" or .type == "embedCard" then "<\(.attrs.url // "")>"
      elif .type == "status" then "`\(.attrs.text // "")`"
      elif .type == "date" then (.attrs.timestamp | tonumber / 1000 | strftime("%Y-%m-%d"))
      elif .type == "paragraph" then kids + "\n\n"
      elif .type == "heading" then ("#" * ((.attrs.level // 3) + 2 | if . > 6 then 6 else . end)) + " " + kids + "\n\n"
      elif .type == "bulletList" then ((.content // []) | map(item("-  ")) | join("")) + "\n"
      elif .type == "orderedList" then ((.content // []) | to_entries | map(.key as $i | .value | item("\($i + 1). ")) | join("")) + "\n"
      elif .type == "listItem" then kids
      elif .type == "codeBlock" then "```\(.attrs.language // "")\n" + kids + "\n```\n\n"
      elif .type == "blockquote" then (kids | rtrim | indent("> ")) + "\n\n"
      elif .type == "rule" then "---\n\n"
      elif .type == "panel" then (kids | rtrim | indent("> ")) + "\n\n"
      elif (.type | test("^media")) then "*[attachment]*\n\n"
      elif .type == "table" then ((.content // []) | map("| " + ((.content // []) | map(adf | rtrim | oneline) | join(" | ")) + " |")) as $rows
        | ($rows[0] // "") + "\n" + (if $rows | length > 0 then "|" + ((.content[0].content // []) | map(" --- |") | join("")) + "\n" else "" end)
          + ($rows[1:] | join("\n")) + "\n\n"
      else kids end;

    # A field value as Markdown (options, users, rich text, plain values)
    def fval:
      if . == null then ""
      elif type == "string" then .
      elif type == "number" or type == "boolean" then tostring
      elif type == "array" then map(fval) | map(select(. != "")) | join(", ")
      elif type == "object" then
        if .type == "doc" then adf | rtrim
        elif has("value") then (.value | tostring) + (if .child.value then " → " + .child.value else "" end)
        elif has("displayName") then .displayName
        elif has("name") then .name
        else "" end
      else "" end;
    # Worth listing under "Other fields": text, options and rich text (not SLAs, ranks, ...)
    def plain: (type == "string" and length > 0 and . != "{}" and (test("^[0-9]+\\|") | not))
      or (type == "object" and (.type == "doc" or (has("value") and has("id"))))
      or (type == "array" and length > 0 and all(.[]; type == "object" and has("value")));
    # Short values as a list; long or multi-line ones as their own block
    def short: (contains("\n") | not) and length <= 80;

    .fields as $f | ($conf.labels // {}) as $labels | ($conf.hide // []) as $hide
    | ([$f[] | objects | .requestType?.name // empty][0] // $f.issuetype.name) as $type
    | [ $labels | to_entries[] | {label: .value, v: ($f[.key] | fval)} | select(.v != "") ]
      + [ $f.description | fval | select(. != "") | {label: "Description", v: .} ] as $req
    | "# \(.key)  \($f.summary // "")\n",
      "**\($f.status.name // "?")**  ·  \([$f.priority.name, $type] | map(select(. != null)) | join("  ·  "))  ",
      "Reporter \($f.reporter.displayName // "?")  ·  created \($f.created | when)  ·  updated \($f.updated | when)\n",

      ( select($req | length > 0)
        | "## Request\n",
          ( [$req[] | select(.v | short)] | select(length > 0)
            | (.[] | "-  **\(.label):** \(.v)"), "" ),
          ( $req[] | select(.v | short | not) | "**\(.label)**\n\n\(.v)\n" ) ),

      ( if $conf.other == false then empty else
          [ $f | to_entries[] | select((.key | startswith("customfield_")) and ($labels[.key] == null)
              and (.key | IN($hide[]) | not) and (.value | plain))
            | "| `\(.key)` | \(.value | fval | split("\n") | first | .[0:100] | oneline) |" ]
          | select(length > 0)
          | "## Other fields\n\n*Name them in the config: `sources.jira.labels`*\n\n| field | value |\n| --- | --- |", .[], ""
        end ),

      ( ($f.comment.comments // []) as $cs
        | "## Comments (\($cs | length))\(if $cs | length > 1 then "  ·  newest first" else "" end)\n",
          ( $cs | reverse[]
            | "### \(.author.displayName // "?")  ·  \(.created | when)\(if .jsdPublic == false then "  ·  *internal*" else "" end)\n",
              (.body | adf | rtrim), "" ) )
  ' $f
}

search() {
  local -a files=( $items/*.json(N) )
  (( $#files )) || return 0
  jq -r --arg q "$1" '
    # all the readable text of a ticket: rich text, plain and option field values
    def texts: [.. | objects | select(.type == "text") | .text // empty]
               + [.. | objects | .value? | strings]
               + [.. | strings | select(test("\\s"))];
    ($q | ascii_downcase | split(" ") | map(select(. != ""))) as $words
    | ([.fields.summary] + (.fields | del(.comment) | texts) + (.fields.comment.comments // [] | map(.body) | texts)
       | unique | join("  ") | gsub("\\s+"; " ")) as $text
    | ($text | ascii_downcase) as $low
    | select(all($words[]; . as $w | $low | contains($w)))
    | ($low | index($words[0])) as $i
    | ([$i - 40, 0] | max) as $from
    | [.key, ($text[$from:$i + 70] | if $from > 0 then sub("^\\S*\\s"; "") else . end | gsub("\\t"; " "))] | @tsv' $files
}

case $1 in
  fetch)   fetch "$2" ;;
  preview) preview "$2" ;;
  search)  search "$2" ;;
  *)       print -u2 "usage: jira fetch <jql> | jira preview <key> | jira search <words>"; exit 1 ;;
esac
