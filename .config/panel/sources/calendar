#!/usr/bin/env zsh
# panel source: Google Calendar, through gog (read-only; log in once: gog auth add).
#
#   calendar fetch upcoming   events from today to the next `days` days, in time order
#   calendar preview <id>     an event as Markdown, from the cache
#   calendar search <words>   "<id>\t<snippet>" for cached events whose title, notes,
#                             location, organizer, people or attachments have all the words
#
# Config (.sources.calendar in panel's config), all optional:
#   account     gog account (default: gog's default account)
#   calendars   ["primary", "Time Blocks", ...] (default: primary)
#   days        how many days ahead (default 7)
#
# Seen state is kept per recurring series, so next week's instance of a weekly
# meeting isn't new; it shows as changed only when the event itself is edited.
emulate -L zsh
setopt extendedglob pipefail
zmodload zsh/datetime
path=(/opt/homebrew/bin $HOME/Development/go/bin $HOME/go/bin $path)

cache="${PANEL_SOURCE_CACHE:?run me through panel}"
conf="$PANEL_SOURCE_CONFIG"
[[ -n $conf ]] || conf='{}'

# gog, read-only and never prompting
g() {
  local account="$(jq -r '.account // empty' <<<"$conf")"
  gog --readonly --no-input --json ${account:+--account "$account"} "$@"
}

# RFC 3339 (with offset) or a date -> epoch
JQ_EPOCH='def epoch: if . == null then null
  elif test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") then (. + "T00:00:00Z" | fromdateiso8601) - (now | localtime | mktime - (now | floor))
  else (capture("^(?<t>[0-9-]+T[0-9:]+)(\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:?[0-9]{2})$") // {t: .[0:19], z: "Z"}) as $c
    | ($c.t + "Z" | fromdateiso8601)
      - (if $c.z == "Z" then 0 else ($c.z | sub(":"; "")) as $o
           | (if $o[0:1] == "-" then -1 else 1 end) * (($o[1:3] | tonumber) * 3600 + ($o[3:5] | tonumber) * 60) end)
  end;'

fetch_upcoming() {
  local days out
  local -a cals
  days="$(jq -r '.days // 7' <<<"$conf")"
  cals=( ${(f)"$(jq -r '.calendars[]? // empty' <<<"$conf")"} )
  (( $#cals )) || cals=( primary )
  mkdir -p $cache
  # ids (primary, an address, c_...) are arguments; names go through --cal
  local -a ids names
  ids=( ${(M)cals:#(primary|*@*|c_*)} ); names=( ${cals:#(primary|*@*|c_*)} )
  out="$(g calendar events $ids ${names[@]/#/--cal=} --from today --to "$(date -v+${days}d +%Y-%m-%d)" \
           --all-pages --max 250 2>&1)" || { print -u2 -r -- "$out"; return 1 }
  jq -c '.events // []' <<<"$out" > $cache/.events.json && mv $cache/.events.json $cache/events.json
  jq "$JQ_EPOCH"'
    def hm: strflocaltime("%H:%M");
    def ymd: strflocaltime("%Y-%m-%d");
    (now | ymd) as $today | (now + 86400 | ymd) as $tomorrow
    # today / tmrw / Thu
    | def day: ymd as $d | if $d == $today then "today" elif $d == $tomorrow then "tmrw" else strflocaltime("%a") end;
    def me: [.attendees[]? | select(.self) | .responseStatus][0];
    map(select(.status != "cancelled"))
    | map( (.start.dateTime // .start.date) as $s | ($s | epoch) as $at
      | { id: .id, key: "", seen: (.recurringEventId // .id),
          at: $at, updated: (.updated | epoch),
          status: (if .start.date then ($at | day) + " all day"
                   else (.end.dateTime | epoch) as $end
                     | ($at | day) + " " + ($at | hm)
                       + (if ($end | ymd) == ($at | ymd) then "–" + ($end | hm) else " → " + ($end | day) end) end),
          title: ((.summary // "(no title)")
                  + (if me == "needsAction" then "  · reply?" elif me == "declined" then "  · declined"
                     elif me == "tentative" then "  · maybe" else "" end)),
          url: .htmlLink })
    | sort_by(.at)' $cache/events.json
}

preview() {
  if [[ ! -f $cache/events.json ]]; then
    print "No events cached yet: they arrive with the next fetch."
    return
  fi
  jq -r --arg id "$1" "$JQ_EPOCH"'
    def when: epoch | strflocaltime("%a %-d %b %H:%M");
    def reply: {"accepted": "✓ going", "declined": "✗ declined", "tentative": "? maybe", "needsAction": "… no reply"}[.] // (. // "?");
    # their HTML description as plain text
    def plain: gsub("<br\\s*/?>"; "\n"; "i") | gsub("</p>|</div>|</li>"; "\n"; "i") | gsub("<li[^>]*>"; "- "; "i")
               | gsub("<a [^>]*href=\"(?<u>[^\"]*)\"[^>]*>(?<t>[^<]*)</a>"; "\(.t) (\(.u))"; "i")
               | gsub("<[^>]+>"; "") | gsub("&nbsp;"; " ") | gsub("&amp;"; "&") | gsub("&lt;"; "<") | gsub("&gt;"; ">")
               | gsub("&quot;"; "\"") | gsub("&#39;"; "'"'"'") | gsub("\n{3,}"; "\n\n");
    (map(select(.id == $id)) | first) as $e
    | if $e == null then "This event is no longer in the cache." else
      ([$e.attendees[]? | select(.self) | .responseStatus][0]) as $me
      | "# \($e.summary // "(no title)")\n",
        ( if $e.start.date then "**\($e.start.date)**, all day  "
          else "**\($e.start.dateTime | when) – \($e.end.dateTime | epoch | strflocaltime("%H:%M"))**"
               + "  (\((($e.end.dateTime | epoch) - ($e.start.dateTime | epoch)) / 60 | floor) min)  " end ),
        "You: \($me | reply)\(if $e.recurringEventId then "  ·  recurring" else "" end)  ",
        "Organizer: \($e.organizer.displayName // $e.organizer.email // "?")\n",
        ( [ (if $e.hangoutLink then "- Meet: \($e.hangoutLink)" else empty end),
            (if $e.location then "- Location: \($e.location)" else empty end) ]
          | select(length > 0) | .[], "" ),
        ( ($e.attendees // []) | select(length > 0)
          | "## People (\(length))\n",
            (sort_by(.responseStatus != "accepted", .displayName // .email)[]
             | "- \(.responseStatus | reply | split(" ")[0])  \(.displayName // .email)\(if .organizer then "  (organizer)" else "" end)"),
            "" ),
        ( ($e.description // "") | select(test("\\S")) | "## Notes\n", (plain | sub("\\s+$"; "")), "" ),
        ( ($e.attachments // []) | select(length > 0) | "## Attachments\n", (.[] | "- [\(.title)](\(.fileUrl))") )
      end' $cache/events.json
}

search() {
  [[ -f $cache/events.json ]] || return 0
  jq -r --arg q "$1" '
    ($q | ascii_downcase | split(" ") | map(select(. != ""))) as $words
    | .[] | select(.status != "cancelled")
    | ([ .summary, (.description // "" | gsub("<[^>]+>"; " ") | gsub("&nbsp;"; " ") | gsub("&amp;"; "&")),
         .location, .organizer.displayName, .organizer.email,
         (.attendees[]? | .displayName, .email), (.attachments[]? | .title) ]
       | map(select(. != null)) | join("  ") | gsub("\\s+"; " ")) as $text
    | ($text | ascii_downcase) as $low
    | select(all($words[]; . as $w | $low | contains($w)))
    | ($low | index($words[0])) as $i
    | ([$i - 40, 0] | max) as $from
    | [.id, ($text[$from:$i + 70] | if $from > 0 then sub("^\\S*\\s"; "") else . end | gsub("\\t"; " "))] | @tsv' $cache/events.json
}

# summary <view>: the HUD's line (and briefing sentences) for one view, from the
# facts on stdin (see ~/.config/panel/lib/summary.jq); prints JSON
summary() {
  jq -c -L "${PANEL_CONFIG_DIR:-$HOME/.config/panel}/lib" 'include "summary";
    .now as $now
    | if .next then ((.next.at - $now) as $in | (.next.title | clean) as $t
        | {line: "next: \($t) in \($in | span)", word: "synced",
           ticker: [.items[] | select((.at // 0) > $now) | "\(.title | clean) in \((.at - $now) | span)"][:3]}
          + (if $in < 4 * 3600 then {brief: ["\($t) starts in \($in | spoken).", "You have \($t) in \($in | spoken).",
                                             "\($t) is coming up in \($in | spoken)."]} else {} end))
      else {line: "clear", word: "synced"} end'
}

case $1 in
  summary) summary "$2" ;;
  fetch)
    case $2 in
      upcoming|"") fetch_upcoming ;;
      *) print -u2 "calendar: unknown query '$2' (try: upcoming)"; exit 1 ;;
    esac ;;
  preview) preview "$2" ;;
  search)  search "$2" ;;
  *) print -u2 "usage: calendar fetch upcoming | calendar preview <event id> | calendar search <words>"; exit 1 ;;
esac
