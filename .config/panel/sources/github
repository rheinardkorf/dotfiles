#!/usr/bin/env zsh
# panel source: GitHub pull requests and Actions runs, through gh (gh auth login).
#
#   github fetch <query>   search PRs (GitHub search syntax, e.g. "is:open is:pr
#                          review-requested:@me"), and refresh the cached details
#                          (description, reviews, comments, checks) of changed ones
#   github fetch actions   the latest run of each workflow per branch, in the repos
#                          you were active in, have open PRs in, or list in config
#   github fetch contributions   per person across orgs: PRs merged/opened, commits,
#                          reviews given, issues; a spark of their activity
#   github preview <id>    a PR, a run or a person as Markdown, from the cache
#   github search <words>  contributions: people whose PRs or repos have the words
#
# Config (.sources.github in panel's config), all optional:
#   actions.repos         ["owner/repo", ...]: always watched
#   actions.active_days   how far back your activity counts (default 14)
#   actions.runs_days     how far back runs are listed (default 14)
#   contributions.orgs    ["org", ...] (required for contributions)
#   contributions.days    window (default 30)
#   contributions.reviews_every   how often reviews are rescanned (default 24h)
#   contributions.exclude  {users: [...], repos: ["name", "cgs-*", "org/name"]}: still
#                          fetched, but left out of the list, previews, stats and find
emulate -L zsh
setopt extendedglob pipefail
zmodload zsh/datetime
path=(/opt/homebrew/bin $path)

cache="${PANEL_SOURCE_CACHE:?run me through panel}"
conf="$PANEL_SOURCE_CONFIG"
[[ -n $conf ]] || conf='{}'
items="$cache/items"
FIELDS=number,title,body,author,state,isDraft,reviewDecision,headRefName,baseRefName,additions,deletions,changedFiles,comments,reviews,statusCheckRollup,url,updatedAt,createdAt,labels,mergeable,reviewRequests

# owner/repo#123 -> a file name
file() { print -r -- "$items/${${1//\//__}//\#/-}.json" }

fetch() {
  local list id url updated f
  local -a need files
  mkdir -p $items
  list="$(gh search prs ${(z)1} --limit 200 --json number,title,repository,url,updatedAt,isDraft)" ||
    { print -u2 -r -- "$list"; return 1 }

  # Details: new PRs and ones updated since they were cached.
  for id url updated in ${(f)"$(jq -r '.[] | "\(.repository.nameWithOwner)#\(.number)\n\(.url)\n\(.updatedAt)"' <<<"$list")"}; do
    f="$(file $id)"
    if [[ -f $f && "$(jq -r .updatedAt $f)" == $updated ]]; then
      touch $f   # still listed: keep it from being pruned
    else
      need+=("$url" "$f")
    fi
  done
  if (( $#need )); then
    print -rl -- $need | xargs -P 4 -n 2 zsh -c '
      tmp="$(mktemp "$2.XXXX")"
      if gh pr view "$1" --json "$0" > "$tmp" 2>/dev/null && jq -e .number "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$2"
      else rm -f "$tmp"; print -u2 "no details for $1"; fi' $FIELDS
  fi
  find $items -name '*.json' -mtime +14 -delete 2>/dev/null

  files=( ${(f)"$(jq -r '.[] | "\(.repository.nameWithOwner)#\(.number)"' <<<"$list" | while read -r id; do file $id; done)"} )
  files=( ${^files}(N) )
  jq --slurpfile d <( (( $#files )) && jq -c '{key: .url, value: .}' $files || true ) '
    ($d | from_entries) as $details
    | map(($details[.url] // {}) as $x
      | ([$x.statusCheckRollup[]? | (.conclusion // .state // "") | ascii_upcase]
         | any(. == "FAILURE" or . == "ERROR" or . == "TIMED_OUT" or . == "CANCELLED")) as $failing
      | { id: "\(.repository.nameWithOwner)#\(.number)",
          key: "\(.repository.name)#\(.number)",
          title: .title,
          status: ((if .isDraft then "draft"
                    else {"APPROVED": "approved", "CHANGES_REQUESTED": "changes", "REVIEW_REQUIRED": "needs review"}[$x.reviewDecision // ""] // "open"
                    end) + (if $failing then " ✗" else "" end)),
          updated: (.updatedAt | fromdateiso8601),
          url: .url })' <<<"$list"
}

# --- actions --------------------------------------------------------------------
# Repos to watch: recently active (your GitHub activity), the configured list,
# and repos where you have an open PR or a review request.
action_repos() {
  local login days cutoff
  local -a repos
  [[ -s $cache/login ]] || gh api user --jq .login > $cache/login 2>/dev/null
  login="$(<$cache/login)"
  days="$(jq -r '.actions.active_days // 14' <<<"$conf")"
  cutoff="$(date -u -r $(( EPOCHSECONDS - days * 86400 )) +%Y-%m-%dT%H:%M:%SZ)"
  [[ -n $login ]] && repos+=( ${(f)"$(gh api "users/$login/events?per_page=100" --paginate \
    --jq ".[] | select(.created_at >= \"$cutoff\") | .repo.name" 2>/dev/null)"} )
  repos+=( ${(f)"$(jq -r '.actions.repos[]? // empty' <<<"$conf")"} )
  repos+=( ${(f)"$(gh search prs is:open is:pr author:@me archived:false --limit 100 \
    --json repository --jq '.[].repository.nameWithOwner' 2>/dev/null)"} )
  repos+=( ${(f)"$(gh search prs is:open is:pr review-requested:@me archived:false --limit 100 \
    --json repository --jq '.[].repository.nameWithOwner' 2>/dev/null)"} )
  print -rl -- ${(u)repos}
}

FAILED='["failure", "timed_out", "startup_failure", "action_required"]'

# One row per workflow per branch: its latest run in the last runs_days (14).
# Jobs are fetched only for failed or running runs, and kept until the run changes.
fetch_actions() {
  local rdays rcut tmp runs
  local -a repos
  mkdir -p $cache/runs
  repos=( ${(f)"$(action_repos)"} )
  (( $#repos )) || { print -r -- '[]'; return 0 }
  rdays="$(jq -r '.actions.runs_days // 14' <<<"$conf")"
  rcut="$(date -u -r $(( EPOCHSECONDS - rdays * 86400 )) +%Y-%m-%d)"
  tmp="$(mktemp -d $cache/.runs.XXXX)"
  print -rl -- $repos | xargs -P 6 -n 1 zsh -c '
    f="$1/${2//\//__}"
    gh api --paginate "repos/$2/actions/runs?per_page=100&created=%3E%3D$0" > "$f.json" 2> "$f.err" || rm -f "$f.json"' $rcut $tmp
  # A repo without Actions (or access) is skipped; all of them failing is an error.
  if [[ -z $tmp/*.json(N[1]) ]]; then
    local err="$(cat $tmp/*.err(N[1]))"; rm -rf $tmp
    print -u2 -r -- "${err:-no workflow runs could be read}"; return 1
  fi
  runs="$(jq -sc '
    def secs: if .run_started_at and .status == "completed"
      then ((.updated_at | fromdateiso8601) - (.run_started_at | fromdateiso8601)) else null end;
    [.[] | .workflow_runs[]?]
    | group_by([.repository.full_name, .workflow_id, (.head_branch // "-")])
    | map(sort_by(.created_at) | last + {history: (.[-10:] | map({status, conclusion, secs: secs}))})' $tmp/*.json(N))"
  rm -rf $tmp

  # Workflow names: a run can carry its own name ("PR #169"), so titles use the
  # workflow's. Cached per repo; looked up again when an unknown workflow appears.
  local repo wfile names='{}'
  for repo in ${(f)"$(jq -r '[.[].repository.full_name] | unique[]' <<<"$runs")"}; do
    wfile="$cache/runs/${repo//\//__}.workflows.json"
    if [[ ! -f $wfile ]] || jq -e --slurpfile w $wfile --arg r $repo \
         'any(.[] | select(.repository.full_name == $r); ((.workflow_id | tostring) as $id | $w[0][$id]) == null)' <<<"$runs" >/dev/null; then
      gh api --paginate "repos/$repo/actions/workflows?per_page=100" --jq '.workflows[] | {(.id | tostring): .name}' 2>/dev/null |
        jq -s 'add // {}' > $wfile.tmp && mv $wfile.tmp $wfile || rm -f $wfile.tmp
    fi
    [[ -f $wfile ]] && names="$(jq -c --slurpfile w $wfile '. + $w[0]' <<<"$names")"
  done
  runs="$(jq -c --argjson n "$names" 'map(. + {workflow: ($n[.workflow_id | tostring] // .name)})' <<<"$runs")"

  jq -r --argjson failed "$FAILED" '.[] | select(.status != "completed" or (.conclusion | IN($failed[])))
    | "\(.repository.full_name) \(.id) \(.run_attempt) \(.updated_at)"' <<<"$runs" |
  while read -r repo id att upd; do
    local jf="$cache/runs/${repo//\//__}__$id-$att.jobs.json"
    [[ -f $jf && "$(jq -r .updated_at $jf)" == $upd ]] && { touch $jf; continue }
    print -r -- "$repo $id $att $upd $jf"
  done | xargs -P 6 -L 1 zsh -c '
    gh api "repos/$0/actions/runs/$1/attempts/$2/jobs?per_page=100" 2>/dev/null |
      jq --arg u "$3" "{updated_at: \$u, jobs: .jobs}" > "$4.tmp" && mv "$4.tmp" "$4" || rm -f "$4.tmp"'
  find $cache/runs -name '*.jobs.json' -mtime +14 -delete 2>/dev/null
  print -r -- "$runs" > $cache/.runs.json && mv $cache/.runs.json $cache/runs.json

  jq --argjson failed "$FAILED" '
    def short: if .status == "in_progress" then "running…" elif .status != "completed" then "queued…"
      else {"success": "success", "failure": "failed ✗", "cancelled": "cancelled", "skipped": "skipped",
            "timed_out": "timed out ✗", "action_required": "needs action ✗", "startup_failure": "startup failed ✗"}[.conclusion]
           // (.conclusion // "?") end;
    def rank: if .status == "completed" and (.conclusion | IN($failed[])) then 0 elif .status != "completed" then 1 else 2 end;
    map({ id: "actions:\(.repository.full_name)/\(.workflow_id)/\(.head_branch // "-")",
          key: .repository.name, title: "\(.workflow) · \(.head_branch // "-") · \(.display_title)",
          status: short, rank: rank, updated: (.updated_at | fromdateiso8601), url: .html_url }
        # last runs: height = how long it took, colour = how it ended
        + ((.history // []) as $h | ([$h[].secs | select(. != null)]) as $d
           | (($d | min) // 0) as $lo | (($d | max) // 0) as $hi
           | { spark: ($h | map(if .secs == null then "▄" else
                 ["▂","▃","▄","▅","▆","▇"][(if $hi > $lo then ((.secs - $lo) / ($hi - $lo) * 5 | round) else 3 end)] end) | join("")),
               spark_colors: ($h | map(if .status != "completed" then "b"
                 else {"success": "g", "failure": "r", "timed_out": "r", "startup_failure": "r", "action_required": "r",
                       "cancelled": "y", "skipped": "d", "neutral": "d"}[.conclusion // ""] // "d" end) | join("")) }))
    | sort_by(.rank, -.updated) | map(del(.rank))' <<<"$runs"
}

preview_run() {   # preview_run actions:<owner/repo>/<workflow id>/<branch>
  local rest=${1#actions:} repo wf branch run id att jf
  repo="${rest%%/*}/${${rest#*/}%%/*}"; rest=${${rest#*/}#*/}; wf=${rest%%/*}; branch=${rest#*/}
  if [[ ! -f $cache/runs.json ]]; then
    print "No workflow runs cached yet: they arrive with the next fetch."
    return
  fi
  run="$(jq -c --arg r $repo --argjson w $wf --arg b "$branch" \
    'map(select(.repository.full_name == $r and .workflow_id == $w and (.head_branch // "-") == $b)) | first' $cache/runs.json)"
  if [[ $run == null ]]; then
    print "This workflow run is no longer in the cache."
    return
  fi
  id="$(jq -r .id <<<"$run")" att="$(jq -r .run_attempt <<<"$run")"
  jf="$cache/runs/${repo//\//__}__$id-$att.jobs.json"
  jq -nr --argjson r "$run" --argjson j "$( [[ -f $jf ]] && cat $jf || print null)" --argjson now $EPOCHSECONDS '
    def when: if . == null then "?" else fromdateiso8601 | strflocaltime("%a %-d %b %H:%M") end;
    def dur: if . < 60 then "\(.)s" elif . < 3600 then "\(. / 60 | floor)m \(. % 60)s"
             else "\(. / 3600 | floor)h \(. % 3600 / 60 | floor)m" end;
    def state: if .status == "in_progress" then "Running" elif .status != "completed" then "Queued"
      else {"success": "Succeeded", "failure": "**Failed**", "cancelled": "Cancelled", "skipped": "Skipped",
            "timed_out": "**Timed out**", "action_required": "**Needs action**", "startup_failure": "**Startup failed**"}[.conclusion]
           // (.conclusion // "?") end;
    def mark: if . == "success" then "✓" elif . == "skipped" then "–" elif . == "cancelled" then "⊘"
              elif . == "in_progress" or . == "queued" or . == "waiting" then "…" else "✗" end;
    ($r.run_started_at // $r.created_at) as $start
    | "# \($r.repository.name) · \($r.workflow // $r.name)\n",
      "\($r | state)  ·  `\($r.head_branch // "-")`  ·  \($r.event)  ·  by \($r.triggering_actor.login // $r.actor.login // "?")"
        + (if ($r.run_attempt // 1) > 1 then "  ·  attempt \($r.run_attempt)" else "" end) + "  ",
      "\($r.display_title)  ·  `\($r.head_sha[0:7])`  ",
      "Started \($start | when)  ·  "
        + (if $r.status == "completed" then "took \((($r.updated_at | fromdateiso8601) - ($start | fromdateiso8601)) | dur)"
           else "running for \(($now - ($start | fromdateiso8601)) | dur)" end) + "  ",
      "[Run #\($r.run_number) on GitHub](\($r.html_url))\n",
      ( if $j then "## Jobs\n",
          ( $j.jobs[] | "- \(.conclusion // .status | mark) **\(.name)**  \(.conclusion // .status)"
              + ([.steps[]? | select(.conclusion == "failure") | .name] | if length > 0 then "  ·  failed at: " + join(", ") else "" end) )
        elif $r.conclusion == "success" then "All jobs passed."
        else empty end )'
}

# --- contributions --------------------------------------------------------------
# Per person, across orgs, over the last `days`: PRs merged and opened, issues
# opened, commits (default branches: what GitHub's commit search indexes) and
# reviews given. Reviews take one call per PR touched, so they're refreshed at
# most every `reviews_every` (default 24h). Bots are left out.
ccfg() { jq -r ".contributions.$1 // empty" <<<"$conf" }
# exclusions: still fetched, left out of everything shown ({users: [...], repos: [globs]})
excl() { jq -c '.contributions.exclude // {}' <<<"$conf" }

# jq: how work flows, from the cached events and reviews.
#   prmap: "repo#n" -> {author, created, merged, state, first_review (by someone else), ...}
#   flowstats($prs; login or null for everyone): lead (opened -> merged), wait
#   (opened -> first review) and the PRs still open
JQ_FLOW='
def ts: .[0:19] + "Z" | fromdateiso8601;
def median: sort as $s | if ($s | length) == 0 then null else $s[($s | length) / 2 | floor] end;
def p90: sort as $s | ($s | length) as $n | if $n == 0 then null else $s[([($n * 0.9 | floor), $n - 1] | min)] end;
def dur: if . == null then "–" elif . < 3600 then "\(. / 60 | floor)m" elif . < 86400 then "\(. / 3600 | floor)h"
         else "\(. / 86400 * 10 | floor / 10)d" end;
def prmap($ev; $rv):
  ([ $ev[] | select((.bot | not) and (.kind == "opened" or .kind == "merged")) ]
   | group_by("\(.repo)#\(.number)")
   | map((map(select(.kind == "opened"))[0]) as $o | (map(select(.kind == "merged"))[0]) as $m
         | { key: "\(.[0].repo)#\(.[0].number)",
             value: { author: .[0].login, repo: .[0].repo, number: .[0].number, title: .[0].title, url: .[0].url,
                      created: (($o.at // $m.created) | if . then ts else null end),
                      merged: ($m.at | if . then ts else null end),
                      state: (if $m then "merged" else ($o.state // null) end) } })
   | from_entries) as $p
  | ($rv | map(select(.bot | not)) | group_by("\(.repo)#\(.number)")
      | map({key: "\(.[0].repo)#\(.[0].number)", value: .}) | from_entries) as $r
  | $p | with_entries(.value.author as $a | .value += {
      first_review: ([($r[.key] // [])[] | select(.login != $a) | .at | ts] | min) });
def flowstats($prs; $login):
  [ $prs[] | select($login == null or .author == $login) ] as $mine
  | { lead: [ $mine[] | select(.merged != null and .created != null) | .merged - .created ],
      wait: [ $mine[] | select(.first_review != null and .created != null) | .first_review - .created | select(. >= 0) ],
      open: [ $mine[] | select(.state == "open" or .state == "draft") ] };
def flowline: "lead \(.lead | median | dur) · wait \(.wait | median | dur)";
# a glob (* = anything) as an anchored regex; without a "/" it matches the repo name in any org
def glob2re: "^" + (gsub("(?<c>[.+?^${}()|\\[\\]\\\\])"; "\\\(.c)") | gsub("\\*"; ".*")) + "$";
def repo_excluded($pats): . as $repo
  | any($pats[]; . as $p | (if ($p | contains("/")) then $repo else ($repo | split("/") | last) end) | test($p | glob2re));
def keep($ex): map(select(
  ((.login // "") | IN(($ex.users // [])[]) | not)
  and ((.repo // "") | repo_excluded($ex.repos // []) | not)));
'


fetch_contributions() {
  local days since org out every age
  local -a orgs
  orgs=( ${(f)"$(jq -r '.contributions.orgs[]? // empty' <<<"$conf")"} )
  (( $#orgs )) || { print -u2 "no orgs: set sources.github.contributions.orgs in panel's config"; return 1 }
  days="$(ccfg days)"; days=${days:-30}
  since="$(date -u -r $(( EPOCHSECONDS - days * 86400 )) +%Y-%m-%d)"
  mkdir -p $cache/contrib
  # each search to its own file (results are too big to pass around as arguments)
  local tmp="$(mktemp -d $cache/contrib/.fetch.XXXX)"
  for org in $orgs; do
    # search is limited to 30 requests a minute: a short pause between searches
    gh search prs --owner $org --created ">=$since" -L 1000 \
      --json author,repository,number,title,body,url,state,isDraft,createdAt > $tmp/$org.opened.json || { rm -rf $tmp; return 1 }; sleep 2
    gh search prs --owner $org --merged --merged-at ">=$since" -L 1000 \
      --json author,repository,number,title,url,closedAt,createdAt > $tmp/$org.merged.json || { rm -rf $tmp; return 1 }; sleep 2
    gh search issues --owner $org --created ">=$since" -L 1000 \
      --json author,repository,number,title,url,createdAt > $tmp/$org.issue.json || { rm -rf $tmp; return 1 }; sleep 2
    gh search commits --owner $org --author-date ">=$since" -L 1000 \
      --json author,commit,repository,url > $tmp/$org.commit.json || { rm -rf $tmp; return 1 }; sleep 2
    gh search prs --owner $org --updated ">=$since" -L 1000 \
      --json repository,number --jq '.[] | "\(.repository.nameWithOwner)/\(.number)"' > $tmp/$org.updated.txt || { rm -rf $tmp; return 1 }; sleep 2
  done
  {
    for x in $tmp/*.opened.json(N); do jq -c 'map({login: .author.login, bot: (.author.type == "Bot"),
      repo: .repository.nameWithOwner, kind: "opened", at: .createdAt, number, title, url,
      state: (if .isDraft then "draft" else .state end), body: ((.body // "")[0:1500])})' $x; done
    for x in $tmp/*.merged.json(N); do jq -c 'map({login: .author.login, bot: (.author.type == "Bot"),
      repo: .repository.nameWithOwner, kind: "merged", at: .closedAt, created: .createdAt, number, title, url})' $x; done
    for x in $tmp/*.issue.json(N); do jq -c 'map({login: .author.login, bot: (.author.type == "Bot"),
      repo: .repository.nameWithOwner, kind: "issue", at: .createdAt, number, title, url})' $x; done
    for x in $tmp/*.commit.json(N); do jq -c 'map(select(.author.login != null) | {login: .author.login,
      bot: (.author.type == "Bot"), repo: .repository.fullName, kind: "commit",
      # commit dates carry the local offset of whoever committed (+10:00): store them as UTC
      at: (.commit.author.date | (capture("^(?<t>[0-9-]+T[0-9:]+)(\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:?[0-9]{2})?$") // {t: .[0:19], z: "Z"}) as $c
           | ($c.t + "Z" | fromdateiso8601) - (if ($c.z // "Z") == "Z" then 0 else ($c.z | sub(":"; "")) as $o
               | (if $o[0:1] == "-" then -1 else 1 end) * (($o[1:3] | tonumber) * 3600 + ($o[3:5] | tonumber) * 60) end) | todate),
      title: (.commit.message | split("\n")[0]), url})' $x; done
  } | jq -s 'add // []' > $cache/contrib/.events.json && mv $cache/contrib/.events.json $cache/contrib/events.json
  cat $tmp/*.updated.txt(N) > $tmp/updated
  [[ -s $cache/contrib/reviews.json ]] || print '{"fetched_at": 0, "reviews": []}' > $cache/contrib/reviews.json

  # reviews: daily, one call per PR touched in the window
  every="$(ccfg reviews_every)"; every=${every:-24h}
  case $every in (<->m) every=$(( ${every%m} * 60 )) ;; (<->h) every=$(( ${every%h} * 3600 )) ;; (*) every=86400 ;; esac
  age=$(( EPOCHSECONDS - $(jq -r '.fetched_at // 0' $cache/contrib/reviews.json 2>/dev/null || print 0) ))
  if (( age >= every )) && [[ -s $tmp/updated ]]; then   # (xargs runs once even with no input)
    mkdir -p $tmp/reviews
    xargs -P 6 -n 1 zsh -c '
      since=$0 dir=$1 pr=$2   # xargs appends each PR after these
      repo=${pr%/*} num=${pr##*/}
      gh api "repos/$repo/pulls/$num/reviews" --paginate \
        --jq ".[] | select(.submitted_at >= \"$since\") | {login: .user.login, bot: (.user.type == \"Bot\"), repo: \"$repo\", kind: \"review\", at: .submitted_at, number: $num, state}" \
        > "$dir/${pr//\//__}.json" 2>/dev/null || rm -f "$dir/${pr//\//__}.json"' $since $tmp/reviews < $tmp/updated 2>/dev/null
    cat $tmp/reviews/*.json(N) | jq -s --argjson now $EPOCHSECONDS '{fetched_at: $now, reviews: .}' > $cache/contrib/.reviews.json &&
      mv $cache/contrib/.reviews.json $cache/contrib/reviews.json
  fi
  rm -rf $tmp

  jq -n --slurpfile e $cache/contrib/events.json --slurpfile r $cache/contrib/reviews.json --argjson days $days --argjson now $EPOCHSECONDS \
       --argjson ex "$(excl)" "$JQ_FLOW"'
    def spark($bars): ($bars | max) as $hi
      | $bars | map(if . == 0 then "▁" else ["▂","▃","▄","▅","▆","▇","█"][(. / $hi * 6 | ceil) - 1 | if . < 0 then 0 else . end] end) | join("");
    def plural($w): if . == 1 then "\(.) \($w)" else "\(.) \($w)s" end;
    (($days + 1) / 2 | floor) as $nb
    | ($e[0] | keep($ex)) as $E | (($r[0].reviews // []) | keep($ex)) as $R
    | prmap($E; $R) as $prs
    | ($E + $R) | map(select((.bot | not) and .login != null and (.login | test("\\[bot\\]$") | not))) as $ev
    # one row per person
    | ($ev | group_by(.login) | map(
        . as $all | ($all | map(.kind) | group_by(.) | map({(.[0]): length}) | add) as $n
        | [range(0; $nb) | . as $b | ($now - $days * 86400 + $b * 172800) as $from
            | [$all[] | select((.at | ts) as $t | $t >= $from and $t < $from + 172800)] | length] as $bars
        | flowstats($prs; $all[0].login) as $f
        # updated stays fixed (counts change every fetch: no ◆); the age column shows the last activity
        | { id: "contrib:\($all[0].login)", key: $all[0].login, seen: "contrib:\($all[0].login)", updated: 1,
            at: ($all | map(.at | ts) | max), total: length,
            status: "\(length) actions",
            title: ([ ($n.merged // 0 | select(. > 0) | "\(.) merged"), ($n.opened // 0 | select(. > 0) | "\(.) opened"),
                      ($n.commit // 0 | select(. > 0) | plural("commit")), ($n.review // 0 | select(. > 0) | plural("review")),
                      ($n.issue // 0 | select(. > 0) | plural("issue")),
                      (if ($f.lead | length) > 0 or ($f.wait | length) > 0 then ($f | flowline) else empty end) ] | join(" · ")),
            spark: spark($bars), spark_colors: ($bars | map(if . == 0 then "d" else "g" end) | join("")),
            url: "https://github.com/\($all[0].login)" })
      | sort_by(-.total) | map(del(.total))) as $people
    # the team: medians, and median lead time per two days (is flow getting faster?)
    | flowstats($prs; null) as $team
    | [ range(0; $nb) | . as $b | ($now - $days * 86400 + $b * 172800) as $from
        | [ $prs[] | select(.merged != null and .created != null and .merged >= $from and .merged < $from + 172800) | .merged - .created ]
        | median // 0 ] as $leadbars
    | [ { id: "contrib:*", key: "everyone", seen: "contrib:*", updated: 1, at: ($ev | map(.at | ts) | max),
          status: "\($ev | length) actions",
          title: "\($team | flowline) · \($team.lead | length) merged · \($team.open | length) open  (spark: median lead time)",
          spark: spark($leadbars), spark_colors: ($leadbars | map(if . == 0 then "d" else "b" end) | join("")),
          url: null } ] + $people'
}

preview_contributor() {   # preview_contributor <login>   (* = everyone)
  [[ -f $cache/contrib/events.json ]] || { print "No contributions cached yet: they arrive with the next fetch."; return }
  [[ -s $cache/contrib/reviews.json ]] || print '{"fetched_at": 0, "reviews": []}' > $cache/contrib/reviews.json
  local days="$(ccfg days)"; days=${days:-30}
  jq -nr --arg u "$1" --slurpfile e $cache/contrib/events.json --slurpfile r $cache/contrib/reviews.json \
       --argjson days $days --argjson now $EPOCHSECONDS --argjson ex "$(excl)" "$JQ_FLOW"'
    def snippet: gsub("\r\n"; "\n") | gsub("<[^>]*>"; "") | split("\n") | map(gsub("^\\s+|\\s+$"; ""))
                 | map(select(length > 0 and (test("^#+\\s") | not) and (test("^- \\[[ x]\\]") | not))) | .[0:2]
                 | map(if length > 200 then .[0:200] + "…" else . end) | join(" / ");
    def spark: (max) as $hi | map(if . == 0 then "▁" else ["▂","▃","▄","▅","▆","▇","█"][(. / $hi * 6 | ceil) - 1 | if . < 0 then 0 else . end] end) | join("");
    # a merged PR as a bar: its length is its lead time (against the longest shown),
    # the solid part waiting for a first review, the shaded part from review to merge
    def lifecycle($longest): (.merged - .created) as $lead
      | (if .first_review then ((.first_review - .created) | if . < 0 then 0 else . end) else $lead end) as $wait
      | ([($lead / $longest * 12 | ceil), 1] | max) as $len | ([($wait / $lead * $len | round), $len] | min) as $w
      | "`" + ("█" * $w) + ("▒" * ($len - $w)) + (" " * (12 - $len)) + "`";
    def flow($f): "| | median | 90% |", "| --- | --- | --- |",
      "| Lead time (opened → merged) | \($f.lead | median | dur) | \($f.lead | p90 | dur) |",
      "| Review wait (opened → first review) | \($f.wait | median | dur) | \($f.wait | p90 | dur) |",
      "", "Open now: \($f.open | length) PR\(if ($f.open | length) == 1 then "" else "s" end)"
          + (if ($f.open | length) > 0 then ", oldest \($now - ($f.open | map(.created // $now) | min) | dur)" else "" end), "";
    def bars($merged): ($merged | map(.merged - .created) | max // 1) as $longest
      | "`█` waiting for review · `▒` review to merge\n",
        ( $merged | sort_by(-.merged)[0:15][]
          | "- \(lifecycle($longest)) [#\(.number)](\(.url)) \(.repo | split("/")[1]): **\(.title)**  "
            + "review \(if .first_review then (.first_review - .created | if . < 0 then 0 else . end | dur) else "none" end)"
            + " · merged \(.merged - .created | dur)" );
    ($e[0] | keep($ex)) as $E | (($r[0].reviews // []) | keep($ex)) as $R
    | prmap($E; $R) as $prs
    | ($E + $R) | map(select((.bot | not) and .login != null and (.login | test("\\[bot\\]$") | not))) as $ev
    | if $u == "*" then
        # the team
        flowstats($prs; null) as $t
        | "# Everyone\n",
          "**\($ev | length) actions** by \($ev | map(.login) | unique | length) people in \($days) days\n",
          "## Flow\n", flow($t),
          "## By person\n",
          "| person | merged | lead (median) | review wait (median) | open |", "| --- | --- | --- | --- | --- |",
          ( [$prs[] | .author] | unique | map(. as $a | flowstats($prs; $a) | {a: $a, f: .})
            | sort_by(-(.f.lead | length))[] | select((.f.lead | length) + (.f.open | length) > 0)
            | "| \(.a) | \(.f.lead | length) | \(.f.lead | median | dur) | \(.f.wait | median | dur) | \(.f.open | length) |" ),
          "",
          "## Slowest merges\n",
          bars([$prs[] | select(.merged != null and .created != null)] | sort_by(-(.merged - .created))[0:10]),
          "",
          ( [$prs[] | select(.state == "open" or .state == "draft")] | select(length > 0)
            | "## Oldest open PRs\n",
              (sort_by(.created)[0:10][] | "- \($now - .created | dur) [#\(.number)](\(.url)) \(.repo | split("/")[1]): **\(.title)**  by \(.author)"
                 + (if .first_review == null then "  · *no review yet*" else "" end)) )
      else
        ($ev | map(select(.login == $u))) as $all
        | ($all | map(.kind) | group_by(.) | map({(.[0]): length}) | add // {}) as $n
        | flowstats($prs; $u) as $f
        | "# \($u)\n",
          "**\($all | length) actions** in \($days) days: \($n.merged // 0) merged · \($n.opened // 0) opened · \($n.commit // 0) commits · \($n.review // 0) reviews · \($n.issue // 0) issues\n",
          "`\([range(0; $days) | . as $d | ($now - ($days - $d) * 86400) as $from
               | [$all[] | select((.at | ts) as $x | $x >= $from and $x < $from + 86400)] | length] | spark)`  per day, oldest first\n",
          "## Flow\n", flow($f),
          ( [$prs[] | select(.author == $u and .merged != null and .created != null)] | select(length > 0)
            | "## Merged PRs\n", bars(.), "" ),
          "## Repos\n",
          "| repo | merged | opened | commits | reviews | issues |", "| --- | --- | --- | --- | --- | --- |",
          ( $all | group_by(.repo) | map({repo: .[0].repo, n: (map(.kind) | group_by(.) | map({(.[0]): length}) | add), total: length})
            | sort_by(-.total)[] | "| \(.repo | split("/")[1]) | \(.n.merged // 0) | \(.n.opened // 0) | \(.n.commit // 0) | \(.n.review // 0) | \(.n.issue // 0) |" ),
          "",
          ( [$all[] | select(.kind == "opened")] | select(length > 0)
            | "## PRs opened (\(length))\n",
              ( group_by(.repo) | sort_by(-length)[]
                | "### \(.[0].repo | split("/")[1])\n",
                  (sort_by(.number)[] | "- [#\(.number)](\(.url)) **\(.title)**  `\(.state | ascii_downcase)`"
                    + ((.body // "") | snippet | if . != "" then "  \n  " + . else "" end)), "" ) )
      end'
}

search_contributions() {   # people whose PR titles, descriptions or repos have all the words
  [[ -f $cache/contrib/events.json ]] || return 0
  jq -r --arg q "$1" --argjson ex "$(excl)" "$JQ_FLOW"'
    ($q | ascii_downcase | split(" ") | map(select(. != ""))) as $words
    | keep($ex) | map(select(.bot | not) | select(.kind == "opened" or .kind == "merged" or .kind == "commit")) | group_by(.login)[]
    | .[0].login as $u
    | [ .[] | "\(.repo) \(.title // "") \(.body // "")" | gsub("\\s+"; " ") ] as $texts
    | [ $texts[] | select(ascii_downcase as $l | all($words[]; . as $w | $l | contains($w))) ] | first
    | select(. != null)
    | (ascii_downcase | index($words[0])) as $i | ([$i - 40, 0] | max) as $from
    | ["contrib:\($u)", (.[$from:$i + 70] | gsub("\\t"; " "))] | @tsv' $cache/contrib/events.json
}

preview() {
  local f="$(file $1)"
  if [[ ! -f $f ]]; then
    print "No details cached for **$1** yet: they arrive with the next fetch."
    return
  fi
  jq -r '
    def when: if . == null then "?" else fromdateiso8601 | strflocaltime("%a %-d %b %H:%M") end;
    # their headings sit under ours: # -> ###
    def demote: gsub("(?m)^(?<h>#{1,4}) "; "##\(.h) ");
    def text: if (. // "") | test("\\S") then demote | sub("\\s+$"; "") else "*(no comment)*" end;
    def review: {"APPROVED": "**approved**", "CHANGES_REQUESTED": "**changes requested**",
                 "COMMENTED": "commented", "DISMISSED": "dismissed"}[.] // (. // "" | ascii_downcase);

    ([.statusCheckRollup[]? | (.conclusion // .state // "") | ascii_upcase | if . == "" then "PENDING" else . end]
      | group_by(.) | map("\(length) \(.[0] | ascii_downcase)") | join(" · ")) as $checks
    | ((.url | capture("github.com/(?<r>[^/]+/[^/]+)/").r) // "") as $repo
    | "# \($repo | split("/")[1])#\(.number)  \(.title)\n",
      "**\(if .isDraft then "Draft" else {"APPROVED": "Approved", "CHANGES_REQUESTED": "Changes requested", "REVIEW_REQUIRED": "Needs review"}[.reviewDecision // ""] // "Open" end)**"
        + "  ·  by \(.author.login)  ·  `\(.headRefName)` → `\(.baseRefName)`"
        + "  ·  +\(.additions) −\(.deletions) in \(.changedFiles) files  ",
      "Checks: \(if $checks == "" then "none" else $checks end)  ·  \(.mergeable | ascii_downcase)  ",
      (if (.reviewRequests | length) > 0 then "Review requested from \([.reviewRequests[] | .login // .name] | join(", "))  " else empty end),
      (if (.labels | length) > 0 then "Labels: \([.labels[].name | "`\(.)`"] | join(" "))  " else empty end),
      "\($repo)  ·  opened \(.createdAt | when)  ·  updated \(.updatedAt | when)\n",

      "## Description\n", (.body | text), "",

      ( ( [ (.comments[]? | {who: .author.login, at: .createdAt, what: "", body}),
            (.reviews[]? | {who: .author.login, at: .submittedAt, what: (.state | review), body}) ]
          | sort_by(.at) | reverse ) as $every
        # reviews with no text are replies made inline on the code (not fetched)
        | [$every[] | select(.what != "commented" or ((.body // "") | test("\\S")))] as $all
        | ($every | length) - ($all | length) as $inline
        | "## Reviews and comments (\($all | length))\(if ($all | length) > 1 then "  ·  newest first" else "" end)\n",
          (if $inline > 0 then "*\($inline) more with inline code comments only (open the PR to see them)*\n" else empty end),
          ( $all[] | "### \(.who)  ·  \(.at | when)\(if .what != "" then "  ·  \(.what)" else "" end)\n", (.body | text), "" ) )
  ' $f
}

# summary <view>: the HUD's line (and briefing sentences) for one view, from the
# facts on stdin (see ~/.config/panel/lib/summary.jq); prints JSON
summary() {
  jq -c -L "${PANEL_CONFIG_DIR:-$HOME/.config/panel}/lib" 'include "summary";
    def title: .title | clean;
    if .view == "actions" then
      if .bad > 0 then {line: "\(.bad) failing", state: "attention",
        ticker: [.items[] | select(.status | test("✗|fail"; "i")) | "✗ \(title)"][:3]}
      else {line: "builds green", word: "linked"} end
    elif .view == "review-requests" then
      if .count > 0 then (.count | count("pull request"; "pull requests")) as $prs
        | {line: "\(.count) reviews waiting", word: "linked",
           brief: ["\($prs | cap) \(if .count == 1 then "awaits" else "await" end) your review.",
                   "You have \(.count | count("review request"; "review requests")) waiting.",
                   "\($prs | cap) could use your eyes."]}
      else {word: "linked"} end
    elif .view == "my-prs" then {line: (if .count > 0 then "\(.count) open PRs" else null end), word: "linked"}
    else {} end'
}

case $1 in
  summary) summary "$2" ;;
  fetch)
    case $2 in
      actions)       fetch_actions ;;
      contributions) fetch_contributions ;;
      *)       fetch "$2" ;;
    esac ;;
  preview)
    case $2 in
      actions:*) preview_run "$2" ;;
      contrib:*) preview_contributor "${2#contrib:}" ;;
      *)         preview "$2" ;;
    esac ;;
  search)  search_contributions "$2" ;;
  *)       print -u2 "usage: github fetch <query>|actions|contributions | github preview <id> | github search <words>"; exit 1 ;;
esac
