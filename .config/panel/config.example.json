{
  // Copy to config.<machine>.json (name in ~/.config/machine-name). Anything
  // that shouldn't be public goes in config.local.json, merged on top.
  // An item counts as seen after the cursor rests on it this long
  "seen_after": "2s",
  // no fetching after this long without keyboard or mouse ("0" = never pause)
  "pause_when_idle": "10m",

  // A pane: a source, a query for it, and how often to fetch
  "panes": {
    "jira": {
      "title": "Jira",
      "source": "jira",
      "views": {
        "assigned": "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC",
        // open tickets that @-mention me (includes ones assigned to me)
        "mentioned": "text ~ currentUser() AND statusCategory != Done ORDER BY updated DESC",
        // my open tickets with a live SLA timer: counting down first, then breached
        "sla": "sla:assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC"
      },
      "every": "5m"
    },
    // GitHub, one pane with views (tab switches): PR views are GitHub searches;
    // "actions" lists workflow runs (repos: sources.github.actions)
    "github": {
      "title": "GitHub",
      "source": "github",
      "views": {
        "actions": "actions",
        "my-prs": "is:open is:pr author:@me archived:false sort:updated-desc",
        "review-requests": "is:open is:pr review-requested:@me archived:false sort:updated-desc"
      },
      "every": "5m"
    },
    // Google Calendar via gog (read-only): today and the next 7 days
    "calendar": {
      "title": "Calendar",
      "source": "calendar",
      "query": "upcoming",
      "every": "15m"
    },

    // AWS: one pane with views, tab switches (profile and regions: sources.aws)
    "aws": {
      "title": "AWS",
      "source": "aws",
      "views": ["alarms", "cloudformation", "dynamodb", "sqs"],
      "every": {"*": "5m", "cloudformation": "15m", "dynamodb": "1h"}
    }
  },

  // A layout is a tmux session: one window per context, one pane per entry
  "layouts": {
    "work": {
      "jira": ["jira"],
      "github": ["github"],
      "aws": ["aws"],
      "calendar": ["calendar"]
    }
  },

  // Settings handed to each source script
  "sources": {
    "aws": {
      "profile": "my-profile",
      "regions": ["us-east-1"],
      // shown when the session has expired
      "login_hint": "use aws sso login"
    },
    "jira": {
      // request fields to show first (acli can't list field names)
      "labels": {},
      // fields to leave out of "Other fields"
      "hide": []
    }
  }
}
