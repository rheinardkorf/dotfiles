{
  // Copy to config.<machine>.json (name in ~/.config/machine-name). Anything
  // that shouldn't be public goes in config.local.json, merged on top.
  // An item counts as seen after the cursor rests on it this long
  "seen_after": "2s",

  // A pane: a source, a query for it, and how often to fetch
  "panes": {
    "my-tickets": {
      "title": "My tickets",
      "source": "jira",
      "query": "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC",
      "every": "2m"
    },
    // GitHub search syntax; gh does the fetching
    "review-requests": {
      "title": "Reviews for me",
      "source": "github",
      "query": "is:open is:pr review-requested:@me archived:false sort:updated-desc",
      "every": "2m"
    },
    "my-prs": {
      "title": "My PRs",
      "source": "github",
      "query": "is:open is:pr author:@me archived:false sort:updated-desc",
      "every": "2m"
    },
    // AWS: one pane with views, tab switches (profile and regions: sources.aws)
    "aws": {
      "title": "AWS",
      "source": "aws",
      "views": ["alarms", "cloudformation", "dynamodb"],
      "every": "5m"
    }
  },

  // A layout is a tmux session: one window per context, one pane per entry
  "layouts": {
    "work": {
      "jira": ["my-tickets"],
      "github": ["review-requests", "my-prs"],
      "aws": ["aws"]
    }
  },

  // Settings handed to each source script
  "sources": {
    "aws": {
      "profile": "my-profile",
      "regions": ["us-east-1"],
      // shown when the session has expired
      "login_hint": "use aws sso login"
    },
    "jira": {
      // request fields to show first (acli can't list field names)
      "labels": {},
      // fields to leave out of "Other fields"
      "hide": []
    }
  }
}
