{
  // mantis (work). Committed, so public: anything sensitive goes in
  // config.local.json (not committed), which is merged on top.
  "seen_after": "2s",
  // no fetching after this long without keyboard or mouse ("0" = never pause)
  "pause_when_idle": "10m",

  // the HUD (panel hud, cmd+shift+a): I.R.I.S., a blend of two Kokoro voices
  "assistant": {
    "name": "I.R.I.S.",
    "meaning": "Intelligent Reporting & Insight System",
    "voice": {"af_jessica": 0.5, "af_river": 0.5},
    "lang": "en-us"
  },

  "panes": {
    // Jira, one pane with views (tab switches)
    "jira": {
      "title": "Jira",
      "source": "jira",
      "views": {
        "assigned": "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC",
        // open tickets that @-mention me (includes ones assigned to me)
        "mentioned": "text ~ currentUser() AND statusCategory != Done ORDER BY updated DESC",
        // my open tickets with a live SLA timer: counting down first, then breached
        "sla": "sla:assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC"
      },
      "every": "5m"
    },

    // GitHub, one pane with views (tab switches); no org limit. PR views are
    // GitHub searches; actions watches repos I'm active in, have PRs in, or list
    // in sources.github.actions.repos.
    "github": {
      "title": "GitHub",
      "source": "github",
      "views": {
        "actions": "actions",
        // per person across orgs (sources.github.contributions)
        "contributions": "contributions",
        "my-prs": "is:open is:pr author:@me archived:false sort:updated-desc",
        "review-requests": "is:open is:pr review-requested:@me archived:false sort:updated-desc"
      },
      // people's contributions: off screen until alt-h reveals it
      "hidden_views": ["contributions"],
      "every": {"*": "5m", "contributions": "6h"}
    },

    // Google Calendar via gog (read-only): today and the next 7 days
    "calendar": {
      "title": "Calendar",
      "source": "calendar",
      "query": "upcoming",
      "every": "15m"
    },

    // the assistant HUD as a window: silent, space for a briefing
    "assistant": {
      "title": "I.R.I.S.",
      "type": "hud"
    },

    // running agents (Claude Code sessions) and this turn's sub-agents, all local;
    // hooks in ~/.claude/settings.json (panel event agents) push changes in.
    // ctrl-o jumps to the agent's tmux pane
    "agents": {
      "title": "Agents",
      "source": "agents",
      "key": "A",
      "query": "active",
      "every": "15s"
    },

    // RSS: each view is a category; the feeds themselves live in config.local.json
    // (panes.rss.views: {"tech": [urls...], ...})
    "rss": {
      "title": "RSS",
      "source": "rss",
      "every": "30m",
      // side by side at any width: a narrow list of titles, the article beside it
      "preview": "side",
      "list": "title",
      // unread articles aren't worth a ●N in the window name
      "count": false
    },

    // AWS prod, one pane with views (tab switches): alarms, CloudFormation stacks, DynamoDB tables, SQS queues
    "aws": {
      "title": "Prod",
      "source": "aws",
      "key": "a",
      // the HUD hears from alarms and SQS; stacks and tables have nothing to say
      "summary": ["alarms", "sqs"],
      "views": ["alarms", "cloudformation", "dynamodb", "sqs"],
      "every": {"*": "5m", "cloudformation": "15m", "dynamodb": "1h"}
    }
  },

  "layouts": {
    "work": {
      "iris": ["assistant"],
      "jira": ["jira"],
      "github": ["github"],
      "aws": ["aws"],
      "calendar": ["calendar"],
      "agents": ["agents"],
      "rss": ["rss"]
    }
  }
}
