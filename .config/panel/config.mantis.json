{
  // mantis (work). Committed, so public: anything sensitive goes in
  // config.local.json (not committed), which is merged on top.
  "seen_after": "2s",

  "panes": {
    // everything open that's mine, newest activity first
    "my-tickets": {
      "title": "My tickets",
      "source": "jira",
      "query": "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC",
      "every": "2m"
    },

    // GitHub, one pane with views (tab switches); no org limit. PR views are
    // GitHub searches; actions watches repos I'm active in, have PRs in, or list
    // in sources.github.actions.repos.
    "github": {
      "title": "GitHub",
      "source": "github",
      "views": {
        "actions": "actions",
        "my-prs": "is:open is:pr author:@me archived:false sort:updated-desc",
        "review-requests": "is:open is:pr review-requested:@me archived:false sort:updated-desc"
      },
      "every": "2m"
    },

    // AWS prod, one pane with views (tab switches): alarms, CloudFormation stacks, DynamoDB tables, SQS queues
    "aws": {
      "title": "Prod",
      "source": "aws",
      "views": ["alarms", "cloudformation", "dynamodb", "sqs"],
      "every": "5m"
    }
  },

  "layouts": {
    "work": {
      "jira": ["my-tickets"],
      "github": ["github"],
      "aws": ["aws"]
    }
  }
}
