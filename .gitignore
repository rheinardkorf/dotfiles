# First, ignore EVERYTHING
*
# Then open it up....

# Root files
# =============================
!.gitignore
!.gitconfig
!Brewfile
!.zshrc
!.gitmux.conf

# Claude skills
# =============================
# First allow...
!.claude/
# Ignore everything inside...
.claude/*
# Then whitelist...
!.claude/skills/
!.claude/skills/**
# ...except skills synced from claude.ai (downloaded automatically, not yours)
.claude/skills/synced/

# Espanso (text expansion)
!.espanso/
!.espanso/**

# VSCode Profiles
!.code_profiles/
!.code_profiles/**

# Config files
# ==============================
# First allow...
!.config/
# Ignore everything inside...
.config/*
# Then whitelist...
!.config/aerospace/
!.config/aerospace/**
!.config/camera_monitor.sh
!.config/mic_monitor.sh 
!.config/ghostty/
!.config/ghostty/**
!.config/hammerspoon/
!.config/hammerspoon/**
!.config/iterm2/
.config/iterm2/*
!.config/iterm2/default_profile.json 
!.config/nvim/
!.config/nvim/**
!.config/oh-my-zsh/
!.config/oh-my-zsh/**
!.config/README.md
!.config/gh/
!.config/gh/**
!.config/git/
!.config/git/**
!.config/karabiner/
!.config/karabiner/**
.config/karabiner/automatic_backups/
!.config/nushell/
!.config/nushell/**
# ...but never shell history (it can contain anything typed, including secrets)
.config/nushell/history.*
!.config/sesh/
!.config/sesh/**
!.config/sketchybar/
!.config/sketchybar/**
!.config/tree-sitter/
!.config/tree-sitter/**
!.config/zsh/
!.config/zsh/**
!.config/tmux/
!.config/tmux/**
# ...but not the downloaded plugins and themes (reinstalled per machine)
.config/tmux/plugins/
.config/tmux/themes/

# .zshrc is allowed above; machine-specific or secret bits go in ~/.zshrc.local (ignored)

# Scripts
!.scripts/
!.scripts/**




# Never track macOS folder metadata, even inside allowed folders
.DS_Store
