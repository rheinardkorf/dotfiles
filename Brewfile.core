# Everything a machine needs to be productive on day one.
# Installed (only if missing, never upgraded) by ~/.scripts/bootstrap.sh.
# Apps only one machine needs don't belong here.

# Terminal workflow (tmux + sesh + Ghostty)
brew "tmux"                  # terminal multiplexer
brew "sesh"                  # tmux session picker (Cmd-n / prefix f / Ctrl-f)
brew "zoxide"                # frecent folders for sesh, and `z`
brew "gitmux"                # git block in the tmux bar
cask "kitty"                 # terminal (cross-platform; config in ~/.config/kitty)
cask "ghostty@tip"           # terminal
cask "font-hack-nerd-font"   # icons in the tmux bar and sesh picker

# Shell and editor (needed by the zsh and nvim configs)
brew "fzf"                   # fuzzy finder; 10-fzf.zsh loads it in every shell
brew "fd"                    # file search used by the fzf setup
brew "mise"                  # Node versions per project (99-mise.zsh, ~/.config/mise)
brew "neovim"                # editor
brew "ripgrep"               # project search (LazyVim)
brew "lazygit"               # git UI; LazyVim opens it with <leader>gg
brew "tree-sitter-cli"       # builds syntax parsers for nvim-treesitter (LazyVim)
brew "bat"                   # syntax-highlighted cat; nicer fzf previews

# Languages
brew "go"                    # Go
brew "rust"                  # Rust (Homebrew build; not rustup)
brew "python@3.13"           # a modern python3 for scripts and tools
brew "uv"                    # Python packages, tools and venvs (replaces pip/pipx)

# General command-line tools
brew "jq"                    # JSON on the command line (bootstrap uses it too)
brew "git"                   # newer Git than macOS ships
brew "gh"                    # GitHub CLI
brew "git-lfs"               # Git large-file storage
brew "coreutils"             # GNU core utilities (gdate, gls, ...)
brew "tree"                  # folder trees
brew "ncdu"                  # find what's using disk space (interactive)
brew "wget"                  # downloads (many install instructions assume it)
brew "httpie"                # friendlier curl for APIs: http GET example.com
brew "pandoc"                # convert between Markdown, Word, HTML, PDF, ...
brew "trash"                 # move files to the Trash instead of deleting
brew "awscli"                # AWS CLI (used by aws-mfa-login)
cask "1password-cli"         # `op`, the 1Password command line

# Desktop: window management and menu bar (configs in ~/.config/aerospace, sketchybar, hammerspoon)
cask "nikitabobko/tap/aerospace", trusted: true           # tiling window manager
brew "felixkratz/formulae/sketchybar", trusted: true      # menu bar (runs as a brew service)
brew "felixkratz/formulae/borders", trusted: true         # focused-window border (started by AeroSpace)
cask "font-sketchybar-app-font"            # app icons in SketchyBar
cask "hammerspoon"                         # automation (camera/mic status, app hotkeys)
cask "hiddenbar"                           # tidy menu-bar icons (apps still managed from their menu entries)
cask "shortcat"                            # keyboard-driven clicking of on-screen UI

# Apps
cask "1password"             # passwords, and the MFA codes for aws-mfa-login
cask "espanso"               # text expansion (config in ~/.espanso)
cask "brave-browser"         # browser
cask "slack"                 # chat
