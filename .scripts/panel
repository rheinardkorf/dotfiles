#!/usr/bin/env zsh
# panel: a tmux control panel of fzf lists over cached data.
#
#   panel up [-d] [layout]  build the tmux session "panel" for a layout, or repair it:
#                           add the windows it's missing; then switch to it (-d: don't)
#   panel fetch [pane...]   fetch now (every pane in the config if none given)
#   panel fetcher [layout]  loop: fetch each pane of the layout when it's due
#   panel view <pane>       the fzf list for one pane (what each tmux pane runs)
#   panel hud [window]      the assistant HUD (full screen; cmd+shift+a opens it in a
#                           tmux popup): a briefing from the cache, spoken. "window":
#                           the silent, always-open version (a pane {"type": "hud"})
#   panel event <source>    hand an event (stdin) to a source, then refresh its panes:
#                           for pushes such as Claude Code hooks (always exits 0, silently)
#
# Everything shown is read from the cache (~/.cache/panel); only fetching talks
# to the outside world.
#
# Config, per machine (name from ~/.config/machine-name, or $PANEL_MACHINE):
#   ~/.config/panel/config.<machine>.json   committed: this machine's panes and layouts
#   ~/.config/panel/config.local.json       optional, not committed: merged on top, for
#                                           anything that shouldn't be public
# JSON, with full-line // comments allowed. Keys:
#   panes    {name: {source, query, every, title}}    every: 30s / 2m / 1h
#            or {name: {source, views: [...], ...}}   one pane, several views (tab
#                                                     switches); each view is the query,
#                                                     or views: {view: query, ...}
#            or {name: {type: "hud", title}}          the assistant HUD as a window
#            hidden_views: [view, ...]: not in the tab rotation, header or counts
#                                       until alt-h reveals them (still fetched)
#   layouts  {name: {window: [pane, ...]}}            one tmux window per context
#   sources  {name: {...}}                            handed to the source script
#            every: "5m", or per view: {"*": "5m", "dynamodb": "1h"} (* = the rest)
#   seen_after                                        e.g. "2s"
#   pause_when_idle                                   no fetching after this long without
#                                                     keyboard or mouse (default "10m", "0" = never)
#   assistant                                         the HUD's {name, meaning, voice, lang, user}
#                                                     (voice: a Kokoro voice, or a blend
#                                                     {"af_jessica": 0.5, "af_river": 0.5})
#   glow_style                                        glow style name or JSON path
#                                                     (default: glow's own, from glow.yml)
#
# Sources are scripts in ~/.config/panel/sources/<name>:
#   <source> fetch <query>   print the items as JSON: [{id, title, status, updated, url, key?, at?, seen?}]
#                            (updated in epoch seconds; key: a shorter id for the list;
#                            at: a start time to count down to; seen: the key seen
#                            state is kept under, when it isn't the id, e.g. a series;
#                            spark: a short strip like "▂▅▇▃" with spark_colors, one
#                            letter per character: g(reen) r(ed) y(ellow) b(lue) d(im)).
#                            $PANEL_SOURCE_CACHE is theirs to keep more in; $PANEL_SINCE
#                            is the last good fetch (epoch).
#                            Also optional: mark (the glyph instead of ● / ◆) and
#                            mark_color (one letter, as spark_colors, plus o(range));
#                            status_color: the status in that colour (else dim);
#                            quiet_before: an item you've never looked at counts as
#                            seen at this time, so it's only marked after a change.
#   <source> preview <id>    print the preview of one item as Markdown, from the cache
#                            only (panel renders it with glow)
#   <source> search <words>  optional: "<id>\t<snippet>" for each cached item whose
#                            content has all the words (used by alt-f)
#   <source> event           optional: an event on stdin (panel event); exit 0 when
#                            something changed (the source's panes are fetched again),
#                            printing the ids of items to mark seen
#
# Items whose url is "tmux:<target>" (e.g. tmux:%33) open by switching tmux there.
#
# In a pane: an item is marked seen after the cursor rests on it (seen_after);
# ● new, ◆ changed since you saw it.
#   enter   full preview (glow pager)   ctrl-o  open in the browser
#   alt-s   mark all seen               alt-u   mark this one unseen
#   ctrl-r  fetch now                   esc     clear the filter (or leave find)
#   tab / shift-tab   next / previous view (panes with views)
#   alt-f   find: search inside the items (cached details); esc or alt-f to go back
#   alt-h   show / hide the pane's hidden views (cmd-shift-h via kitty)
#   home / end   top / bottom of the list (page up / down: a page)
emulate -L zsh
setopt extendedglob pipefail
zmodload zsh/system zsh/datetime
zmodload -F zsh/stat b:zstat
path=(/opt/homebrew/bin $path)

PANEL_CONFIG_DIR="${PANEL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/panel}"
PANEL_CACHE="${PANEL_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/panel}"
SESSION=panel
self="${0:A}"

die() { print -u2 "panel: $*"; exit 1 }

# conf [jq args...]: query the config: this machine's file with config.local.json
# merged on top (objects merge, everything else is replaced), // comment lines stripped
conf() {
  local name_file="${XDG_CONFIG_HOME:-$HOME/.config}/machine-name" machine=$PANEL_MACHINE f
  [[ -n $machine || ! -r $name_file ]] || machine="$(<$name_file)"
  machine=${machine//[[:space:]]/}
  [[ -n $machine ]] || die "no machine name: put one in $name_file (or set PANEL_MACHINE)"
  f="$PANEL_CONFIG_DIR/config.$machine.json"
  [[ -f $f ]] || die "no config for \"$machine\": $f (see config.example.json)"
  for f in $f $PANEL_CONFIG_DIR/config.local.json(N); do
    sed -E '/^[[:space:]]*\/\//d' $f
  done | jq -s 'reduce .[] as $c ({}; . * $c)' | jq -r "$@"
}

seconds() {   # 30s / 2m / 1h -> seconds
  case $1 in
    (<->s) print ${1%s} ;;
    (<->m) print $(( ${1%m} * 60 )) ;;
    (<->h) print $(( ${1%h} * 3600 )) ;;
    (<->)  print $1 ;;
    (*)    print 120 ;;
  esac
}

pane_source() { conf --arg p "${1%%/*}" '.panes[$p].source // empty' }

# A unit is what gets fetched, cached and listed: a pane, or one of its views
# (pane/view) when the pane has "views" (e.g. aws/alarms, aws/cloudformation).
# views: ["a", "b"] (each name is also the query) or {"a": "query", ...}
pane_views() { conf --arg p "${1%%/*}" '.panes[$p].views // [] | if type == "object" then keys_unsorted[] else .[] end' }
pane_units() {   # pane_units <pane>
  local -a views=( ${(f)"$(pane_views $1)"} )
  if (( $#views )); then print -rl -- ${1}/${^views}; else print -r -- $1; fi
}
hidden_views() { conf --arg p "${1%%/*}" '.panes[$p].hidden_views // [] | .[]' }
# visible_views <pane> [pid]: the views in rotation (hidden ones only when revealed)
visible_views() {
  local -a views=( ${(f)"$(pane_views $1)"} ) hidden=( ${(f)"$(hidden_views $1)"} )
  if [[ -n $2 && -f "$PANEL_CACHE/panes/$1/reveal.$2" ]] || (( ! $#hidden )); then
    print -rl -- $views
  else
    print -rl -- ${views:|hidden}
  fi
}

# visible_units <pane>: its units without the hidden views (for counts)
visible_units() {
  local -a views=( ${(f)"$(visible_views $1)"} )
  if (( $#views )); then print -rl -- ${1}/${^views}; else print -r -- $1; fi
}

# cur_unit <pane> <pid>: the unit an open view (fzf instance <pid>) is showing
cur_unit() {
  local -a views=( ${(f)"$(visible_views $1 $2)"} )
  local v
  (( $#views )) || { print -r -- $1; return }
  v="$(cat "$PANEL_CACHE/panes/$1/view.$2" 2>/dev/null)"
  (( ${views[(Ie)$v]} )) || v=$views[1]
  print -r -- $1/$v
}

# Run a source script with its cache and config.
run_source() {
  local source=$1; shift
  [[ -x $PANEL_CONFIG_DIR/sources/$source ]] || { print -u2 "panel: no source script: $source"; return 1 }
  PANEL_SOURCE_CACHE="$PANEL_CACHE/sources/$source" \
  PANEL_SOURCE_CONFIG="$(conf -c --arg s "$source" '.sources[$s] // {}')" \
    "$PANEL_CONFIG_DIR/sources/$source" "$@"
}

# Tell every open view of a unit's pane to re-read the cache. Each view has its
# own socket (fzf.<pid>.sock); one that doesn't answer is left over, so remove it.
notify() {
  local pane=${1%%/*} sock pid
  for sock in "$PANEL_CACHE/panes/$pane"/fzf.*.sock(N=); do
    pid=${${sock:t}//[^0-9]/}
    curl -s -m 2 --unix-socket "$sock" -X POST http://localhost \
      -d "reload($self _lines $pane $pid)" >/dev/null 2>&1 || rm -f "$sock"
  done
  return 0
}

# --- fetching -------------------------------------------------------------------
fetch_pane() {   # fetch_pane <unit>
  local pane=$1 dir="$PANEL_CACHE/panes/$1" source query since out err fd
  source="$(pane_source $pane)"
  [[ -n $source ]] || { print -u2 "panel: unknown pane: $pane"; return 1 }
  if [[ $pane == */* ]]; then   # a view: its query, or its name
    query="$(conf --arg p ${pane%%/*} --arg v ${pane#*/} '.panes[$p].views | if type == "object" then .[$v] else $v end')"
  else query="$(conf --arg p $pane '.panes[$p].query // ""')"; fi
  mkdir -p $dir
  : >> $dir/lock
  zsystem flock -t 0 -f fd $dir/lock 2>/dev/null || return 2   # already fetching
  since="$(jq -r '.ok_at // empty' $dir/meta.json 2>/dev/null)"
  out="$(mktemp $dir/.items.XXXX)" err="$(mktemp $dir/.err.XXXX)"
  if PANEL_SINCE=$since run_source $source fetch "$query" > $out 2> $err &&
     jq -e 'type == "array"' $out >/dev/null 2>&1; then
    mv $out $dir/items.json
    jq -n --argjson t $EPOCHSECONDS '{ok_at: $t, fetched_at: $t}' > $dir/.meta && mv $dir/.meta $dir/meta.json
  else
    rm -f $out
    jq -n --argjson t $EPOCHSECONDS --arg e "$(tail -3 $err)" --arg ok "$since" \
      '{ok_at: ($ok | tonumber? // null), fetched_at: $t, error: (if $e == "" then "fetch failed" else $e end)}' \
      > $dir/.meta && mv $dir/.meta $dir/meta.json
  fi
  rm -f $err
  exec {fd}>&-
  notify $pane
}

layout_panes() { conf --arg l "$1" '. as $c | [.layouts[$l] // {} | .[][]] | unique | .[] | select($c.panes[.].source)' }
layout_units() { local p; for p in ${(f)"$(layout_panes $1)"}; do pane_units $p; done }
default_layout() { conf '.layouts | keys_unsorted[0] // empty' }

# Long-running loops (fetcher, view) start again when panel itself changes, so
# they never keep running old code.
loaded="$(zstat +mtime $self)"
changed() { [[ "$(zstat +mtime $self 2>/dev/null)" != $loaded ]] }

# every <unit>: its fetch interval in seconds ("every" per pane, or per view)
every() {
  seconds "$(conf --arg p ${1%%/*} --arg v "${1#*/}" '.panes[$p].every
    | if type == "object" then (.[$v] // .["*"] // "5m") else (. // "2m") end')"
}

# Seconds since the last keyboard or mouse input (macOS)
idle_seconds() { ioreg -c IOHIDSystem | awk '/HIDIdleTime/ { print int($NF / 1000000000); exit }' }

fetcher() {
  local layout=${1:-$(default_layout)} pane every last pause idle paused=0
  print "panel: fetching panes of layout '$layout' when due (ctrl-c stops)"
  while :; do
    # away from the keyboard: fetch nothing until you're back (then whatever is due)
    pause="$(seconds "$(conf '.pause_when_idle // "10m"')")"
    idle="$(idle_seconds)"
    if (( pause > 0 && ${idle:-0} >= pause )); then
      (( paused )) || print "$(strftime %H:%M:%S $EPOCHSECONDS)  idle: paused until you're back"
      paused=1
      sleep 15
      changed && { print "panel changed: restarting"; exec $self fetcher $layout }
      continue
    fi
    (( paused )) && print "$(strftime %H:%M:%S $EPOCHSECONDS)  back: fetching what's due"
    paused=0
    for pane in ${(f)"$(layout_units $layout)"}; do
      every="$(every $pane)"
      last="$(jq -r '.fetched_at // 0' "$PANEL_CACHE/panes/$pane/meta.json" 2>/dev/null)"
      (( EPOCHSECONDS - ${last:-0} >= every )) || continue
      print -n "$(strftime %H:%M:%S $EPOCHSECONDS)  $pane ... "
      if fetch_pane $pane; then
        jq -r 'if .error then "failed: " + .error else "ok" end' "$PANEL_CACHE/panes/$pane/meta.json"
      else
        (( $? == 2 )) && print "already fetching" || print "failed"
      fi
    done
    sleep 15
    changed && { print "panel changed: restarting"; exec $self fetcher $layout }
  done
}

# event <source>: a push (hook payload on stdin) for a source. The source records
# it; when something changed, fetch the source's panes that are open, mark what it
# says as seen, and the views reload. Never fails or prints: hooks call it.
event() {
  local source=$1 input ids pane unit try
  input="$(cat)"
  export PANEL_EVENT_AT=$EPOCHREALTIME
  ids="$(print -r -- $input | run_source $source event 2>/dev/null)" || return 0
  for pane in ${(f)"$(conf --arg s $source '.panes | to_entries[] | select(.value.source == $s) | .key' 2>/dev/null)"}; do
    for unit in ${(f)"$(pane_units $pane)"}; do
      # only panes someone is looking at; the fetcher keeps the rest up to date
      local -a socks=( "$PANEL_CACHE/panes/$pane"/fzf.*.sock(N=) )
      if (( $#socks )); then
        for try in {1..20}; do fetch_pane $unit && break; (( $? == 2 )) || break; sleep 0.25; done
      fi
      [[ -n $ids && -f "$PANEL_CACHE/panes/$unit/items.json" ]] && mark_seen $unit ${(f)ids} && notify $unit
    done
  done
  return 0
}

# --- seen -----------------------------------------------------------------------
# seen.json: {"<source>:<id>": <updated when you saw it>}. Global, no content.
SEEN="$PANEL_CACHE/seen.json"
seen_json() { [[ -s $SEEN ]] && cat $SEEN || print '{}' }

# Shared by the list and the counts: is this item new / changed / seen?
JQ_STATE='def state($seen; $src): ($seen["\($src):\(.seen // .id)"] // .quiet_before) as $s
  | if $s == null then "new" elif (.updated // 0) > $s then "changed" else "seen" end;'

# seen_update <pane> <jq filter over $ids/$items>: change seen.json under a lock
seen_update() {
  local pane=$1 filter=$2; shift 2
  local source="$(pane_source $pane)" fd tmp
  mkdir -p $PANEL_CACHE; : >> $PANEL_CACHE/seen.lock
  zsystem flock -f fd $PANEL_CACHE/seen.lock || return 1
  tmp="$(mktemp $PANEL_CACHE/.seen.XXXX)"
  seen_json | jq --arg src $source --argjson ids "$(print -rl -- $@ | jq -R . | jq -sc .)" \
    --slurpfile items "$PANEL_CACHE/panes/$pane/items.json" "$filter" > $tmp && mv $tmp $SEEN
  exec {fd}>&-
}
mark_seen()   { seen_update $1 'reduce ($items[0][] | select(.id | IN($ids[]))) as $i (.; .["\($src):\($i.seen // $i.id)"] = ($i.updated // 0))' "${@:2}" }
mark_unseen() { seen_update $1 'reduce ($items[0][] | select(.id | IN($ids[]))) as $i (.; del(.["\($src):\($i.seen // $i.id)"]))' "${@:2}" }

is_unseen() {   # is_unseen <pane> <id>
  jq -e --arg src "$(pane_source $1)" --arg id $2 --argjson seen "$(seen_json)" \
    "$JQ_STATE"' any(.[]; .id == $id and state($seen; $src) != "seen")' \
    "$PANEL_CACHE/panes/$1/items.json" >/dev/null 2>&1
}

# The cursor landed on an item: mark it seen if it's still there after seen_after.
on_focus() {
  local pane=$1 id=$2 dir="$PANEL_CACHE/panes/$1" token=$EPOCHREALTIME delay
  [[ -n $id ]] || return 0
  print -r -- "$id $token" > $dir/focus
  is_unseen $pane $id || return 0
  delay="$(seconds "$(conf '.seen_after // "2s"')")"
  {
    sleep $delay
    [[ "$(<$dir/focus)" == "$id $token" ]] || exit 0
    # only while you're looking: the active pane of the shown window, on screen
    [[ -z $TMUX_PANE || "$(tmux display -p -t $TMUX_PANE \
      '#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}}')" == 1 ]] || exit 0
    mark_seen $pane $id && notify $pane
  } </dev/null >/dev/null 2>&1 &!
}

# Window name gets the count of unseen items across its panes: "me ●3".
update_window_name() {
  [[ -n $TMUX_PANE ]] || return 0
  local base p n=0 c seen="$(seen_json)"
  base="$(tmux show-options -wqv -t $TMUX_PANE @panel_name)"
  [[ -n $base ]] || return 0
  for p in ${(f)"$(tmux list-panes -t $TMUX_PANE -F '#{@panel_pane}' | while read -r q; do [[ -n $q ]] && visible_units $q; done)"}; do
    [[ -f "$PANEL_CACHE/panes/$p/items.json" ]] || continue
    c="$(jq --arg src "$(pane_source $p)" --argjson seen "$seen" \
      "$JQ_STATE"' [.[] | select(state($seen; $src) != "seen")] | length' "$PANEL_CACHE/panes/$p/items.json")"
    (( n += c ))
  done
  tmux rename-window -t $TMUX_PANE "$base$( (( n )) && print " ●$n")"
}

# --- viewing --------------------------------------------------------------------
# One line per item: "<id>\t<display>"; the first line is a header (status of the fetch).
lines() {   # lines <pane> <pid>
  local pane="$(cur_unit $1 $2)" tabs="" v cur
  local dir="$PANEL_CACHE/panes/$pane"
  # views: all of them in the header, the one shown in bold
  if [[ $pane == */* ]]; then
    cur=${pane#*/}
    local -a hidden=( ${(f)"$(hidden_views $1)"} )
    for v in ${(f)"$(visible_views $1 $2)"}; do
      local label=$v; (( ${hidden[(Ie)$v]} )) && label=$'\U000F0209'" $v"   # nf-md-eye_off
      [[ $v == $cur ]] && tabs+=$'\e[0;1m'"$label"$'\e[0;2m  ' || tabs+="$label  "
    done
    tabs+="(tab)  ·  "
  fi
  if [[ ! -f $dir/items.json ]]; then
    print -r -- $'\t'$'\e[2m'"$tabs"$'\e[0m'"waiting for the first fetch... (is 'panel fetcher' running?)"
    return
  fi
  # find mode (alt-f): only items whose content has the words, with a snippet
  local find="$PANEL_CACHE/panes/$1/find.$2" words="" matches=null
  if [[ -f $find ]]; then
    words="$(<$find)"
    if [[ -z ${words//[[:space:]]/} ]]; then
      print -r -- $'\t'$'\e[2m'"$tabs"$'\e[0m'"find: type words to search inside the items (esc to go back)"
      return
    fi
    if ! matches="$(run_source $(pane_source $pane) search "$words" 2>/dev/null |
                    jq -Rn '[inputs | split("\t") | {(.[0]): (.[1] // "")}] | add // {}')"; then
      print -r -- $'\t'$'\e[2m'"$tabs"$'\e[0m'"find: this source can't search inside its items (esc to go back)"
      return
    fi
  fi
  jq -r --arg src "$(pane_source $pane)" --argjson now $EPOCHSECONDS --arg tabs "$tabs" \
    --argjson matches "$matches" --arg words "$words" \
    --argjson seen "$(seen_json)" --argjson m "$(cat $dir/meta.json 2>/dev/null || print '{}')" \
    "$JQ_STATE"'
    def hm: if . == null then "never" else strflocaltime("%H:%M") end;
    # time since (or, for items with a start time "at", until): 5m, 3h, in 2h, now
    def age: if (. // 0) == 0 then "?" else ($now - .) as $s
      | if $s < -86400 then "in \(-$s / 86400 | floor)d" elif $s < -3600 then "in \(-$s / 3600 | floor)h"
        elif $s < -60 then "in \(-$s / 60 | floor)m" elif $s < 0 then "now"
        elif $s < 3600 then "\($s / 60 | floor)m" elif $s < 86400 then "\($s / 3600 | floor)h"
        elif $s < 8640000 then "\($s / 86400 | floor)d" elif $s < 31536000 then "\($s / 2592000 | floor)mo"
        else "\($s / 31536000 | floor)y" end end;
    def pad($n): if length >= $n then .[0:$n - 1] + "…" else . + (" " * ($n - length)) end;
    def rgb($c): "\u001b[38;2;\($c)m";
    "\u001b[2m" as $dim | "\u001b[1m" as $bold | "\u001b[0m" as $off |
    # key column: as wide as the longest key (max 30); none when no item has one
    ([.[] | .key // .id | length] | max // 0 | if . > 30 then 30 else . end) as $w |
    # spark column: as wide as the longest strip (right-aligned: newest on the right)
    ([.[] | .spark // "" | length] | max // 0 | if . > 24 then 24 else . end) as $kw |
    {"g": "166;227;161", "r": "243;139;168", "y": "249;226;175", "b": "137;180;250", "d": "108;112;134", "o": "250;179;135"} as $palette |
    def spark: (.spark // "" | .[-$kw:]) as $s | (.spark_colors // "" | .[-($s | length):]) as $c
      | (" " * ($kw - ($s | length)))
        + ([range(0; $s | length)] | map(
            $palette[$c[.:.+1]] as $rgb
            | (if $rgb then rgb($rgb) else "" end) + $s[.:.+1] + $off) | join(""));
    # status column: as wide as the longest status, between 16 and 24
    ([.[] | .status // "" | length] | max // 0 | [., 15] | max | [., 23] | min) as $sw |
    (if $matches then map(select($matches[.id] != null) | .title += "  " + $dim + "… " + $matches[.id] + " …" + $off) else . end) |
    ( "\t" + $dim + $tabs + $off
      + (if $matches then rgb("249;226;175") + "find \"\($words)\": \(length) match\(if length == 1 then "" else "es" end)  ·  " + $off else "" end)
      + if $m.error then rgb("243;139;168") + "fetch failed at \($m.fetched_at | hm): \($m.error | split("\n")[0])  ·  showing \($m.ok_at | hm)" + $off
             else $dim + "fetched \($m.ok_at | hm)  ·  \(length) items  ·  ● new  ◆ changed" + $off end ),
    ( .[] | state($seen; $src) as $st
      | ($palette[.mark_color // ""] // (if $st == "new" then $palette.o else $palette.y end)) as $mc
      | (if $st == "seen" then " " else rgb($mc) + (.mark // (if $st == "new" then "●" else "◆" end)) + $off end) as $mark
      | "\(.id)\t\($mark) \(if $w > 0 then $bold + (.key // .id | pad($w + 2)) + $off + " " else "" end)\(if $palette[.status_color // ""] then $off + rgb($palette[.status_color]) else $dim end)\(.status // "" | pad($sw + 1))\($off)\($dim) \(.at // .updated | age | pad(7))\($off) \(if $kw > 0 then spark + "  " else "" end)\(.title // "" | sub("^\\s+"; ""))" )
  ' $dir/items.json
  update_window_name
}

# glow_style in the config, else glow's own style (glow.yml), so both look the
# same. glow drops colour when piped on "auto", so that and a missing file -> dark.
glow_style() {
  local s="$(conf '.glow_style // empty')"
  [[ -n $s ]] || s="$(sed -nE 's/^style:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/p' \
    "${XDG_CONFIG_HOME:-$HOME/.config}/glow/glow.yml" 2>/dev/null)"
  s=${s/#\~/$HOME}
  [[ -z $s || $s == auto || ( $s == */* && ! -f $s ) ]] && s=dark
  print -r -- $s
}

# preview <pane> <id> [full]: the source's Markdown, rendered by glow to fit the
# preview pane, or in glow's pager when full.
preview() {
  local source="$(pane_source $1)" style
  [[ -n $2 ]] || return 0
  style="$(glow_style)"
  if [[ $3 == full ]]; then
    local cols=${COLUMNS:-$(tput cols 2>/dev/null || print 100)}
    run_source $source preview $2 | glow -p -s "$style" -w $(( cols > 120 ? 120 : cols )) -
  else
    run_source $source preview $2 | glow -s "$style" -w ${FZF_PREVIEW_COLUMNS:-80} -
  fi
}

# prompt <pane> <pid>: "Title › " or, with views, "Title › view › "
prompt() {
  local title="$(conf --arg p $1 '.panes[$p].title // $p')" unit="$(cur_unit $1 $2)"
  local find=""; [[ -f "$PANEL_CACHE/panes/$1/find.$2" ]] && find=$'\e[38;2;249;226;175;1m'"find › "$'\e[0m'
  if [[ $unit == */* ]]; then print -r -- "$title › ${unit#*/} › $find"; else print -r -- "$title › $find"; fi
}

# switch_view <pane> <pid> <+1|-1>: show the next / previous view
switch_view() {
  local -a views=( ${(f)"$(visible_views $1 $2)"} )
  local cur i
  (( $#views )) || return 0
  cur="$(cur_unit $1 $2)"; cur=${cur#*/}
  i=${views[(Ie)$cur]}
  i=$(( (i - 1 + $3 + $#views) % $#views + 1 ))
  print -r -- $views[i] > "$PANEL_CACHE/panes/$1/view.$2"
}

# toggle_find <pane> <pid>: switch find mode; prints the fzf actions to do it
toggle_find() {
  local f="$PANEL_CACHE/panes/$1/find.$2" redraw="transform-prompt($self _prompt $1 $2)+reload($self _lines $1 $2)"
  local title="$(conf --arg p $1 '.panes[$p].title // $p' | tr -d '()')"
  if [[ -f $f ]]; then
    rm -f $f
    print -r -- "unbind(change)+enable-search+clear-query+change-input-label()+$redraw"
  else
    : > $f
    print -r -- "disable-search+clear-query+rebind(change)+change-input-label( find inside $title  ·  esc to go back )+$redraw"
  fi
}

# toggle_reveal <pane> <pid>: show / hide hidden views; prints the fzf actions
toggle_reveal() {
  local f="$PANEL_CACHE/panes/$1/reveal.$2"
  if [[ -f $f ]]; then rm -f $f; else : > $f; fi
  print -r -- "transform-prompt($self _prompt $1 $2)+reload($self _lines $1 $2)"
}

# esc_key <pane> <pid>: leave find mode, or else clear the query
esc_key() {
  if [[ -f "$PANEL_CACHE/panes/$1/find.$2" ]]; then toggle_find $1 $2; else print -r -- clear-query; fi
}

# find <pane> <pid> <words>: remember what to find, then list
find_words() { print -r -- "$3" > "$PANEL_CACHE/panes/$1/find.$2"; lines $1 $2 }

open_url() {   # open_url <unit> <id>
  local url="$(jq -r --arg id $2 '.[] | select(.id == $id) | .url // empty' "$PANEL_CACHE/panes/$1/items.json")"
  case $url in
    ("") return 0 ;;
    (tmux:*) tmux switch-client -t "${url#tmux:}" 2>/dev/null ;;
    (*) open "$url" ;;
  esac
}

view() {
  local pane=$1 dir="$PANEL_CACHE/panes/$1" sock title
  [[ -n "$(pane_source $pane)" ]] || die "unknown pane: $pane"
  mkdir -p $dir
  sock=$dir/fzf.$$.sock   # this view's own: a pane can be open more than once
  title="$(conf --arg p $pane '.panes[$p].title // $p')"
  [[ -n $TMUX_PANE ]] && tmux set-option -p -t $TMUX_PANE @panel_pane $pane
  trap "rm -f $sock $dir/view.$$ $dir/find.$$ $dir/reveal.$$" EXIT
  trap 'exit 0' HUP TERM
  # ctrl-c ends fzf and it starts again; close the pane with tmux (prefix x).
  while :; do
    rm -f $sock $dir/find.$$ $dir/reveal.$$   # (re)start in normal search, hidden views hidden
    # prompt first: with --track, fzf drops actions that come after a reload
    local me="$pane $$" redraw="transform-prompt($self _prompt $pane $$)+reload($self _lines $pane $$)"
    lines $pane $$ | fzf --ansi --listen=$sock --delimiter=$'\t' --with-nth=2 --id-nth=1 --track \
      --no-sort --header-lines=1 --layout=reverse --info=inline-right --prompt="$(prompt $pane $$)" \
      --input-border=line --color='input-label:#f9e2af:bold' \
      --preview "$self _preview $pane {1}" \
      --preview-window 'right,60%,wrap,border-left,<110(down,65%,wrap,border-top)' \
      --bind "focus:execute-silent($self _focus $me {1})" \
      --bind "esc:transform($self _esc $me)" \
      --bind "enter:execute($self _preview $pane {1} full)" \
      --bind "ctrl-o:execute-silent($self _open $me {1})" \
      --bind "ctrl-r:execute-silent($self _fetch_now $me >/dev/null 2>&1 &)" \
      --bind "alt-s:execute-silent($self _seen_all $me)+reload($self _lines $me)" \
      --bind "alt-u:execute-silent($self _unseen $me {1})+reload($self _lines $me)" \
      --bind "start:unbind(change)" \
      --bind "change:reload($self _find $me {q})" \
      --bind "alt-f:transform($self _toggle_find $me)" \
      --bind "alt-h:transform($self _reveal $me)" \
      --bind "tab:execute-silent($self _view $me 1)+$redraw" \
      --bind "shift-tab:execute-silent($self _view $me -1)+$redraw" \
      --bind "home:first" --bind "end:last"
    sleep 0.5
    changed && exec $self view $pane
  done
}

# hud [window]: the assistant HUD (~/.config/panel/hud) over the default layout's panes
hud() {
  local mode=${1:-popup} job user
  user="$(conf '.assistant.user // empty')"
  [[ -n $user ]] || user="$(id -F 2>/dev/null)"; user=${user%% *}
  job="$(mktemp "${TMPDIR:-/tmp}/panel-hud.XXXXXX")"
  # every unit of the layout, in order, with what the HUD needs to know about it
  conf --arg l "$(default_layout)" --arg user "$user" --arg cache "$PANEL_CACHE" --arg mode $mode '
    . as $c | {assistant: (.assistant // {}), user: $user, cache: $cache, mode: $mode,
      units: [ reduce ($c.layouts[$l][][]) as $p ([]; if any(.[]; . == $p) then . else . + [$p] end) | .[]
        | . as $p | $c.panes[$p] as $P | select($P.source)
        | if $P.views == null then {unit: $p, pane: $p, view: null, source: $P.source, title: ($P.title // $p), hidden: false}
          else ($P.views | if type == "object" then keys_unsorted else . end)[] as $v
            | {unit: "\($p)/\($v)", pane: $p, view: $v, source: $P.source, title: ($P.title // $p),
               hidden: ($v | IN(($P.hidden_views // [])[]))} end ] }' > $job || die "can't read the config"
  [[ $mode == window ]] || exec python3 -I "$PANEL_CONFIG_DIR/hud/hud.py" $job
  python3 -I "$PANEL_CONFIG_DIR/hud/hud.py" $job
}

# hud_window: the HUD as a panel window: starts again if it ends (ctrl-c), and
# when panel changes
hud_window() {
  trap 'exit 0' HUP TERM
  while :; do
    hud window
    sleep 0.5
    changed && exec $self hud window
  done
}

# pane_cmd <pane>: what a pane of a layout runs
pane_cmd() {
  if [[ "$(conf --arg p $1 '.panes[$p].type // empty')" == hud ]]; then print -r -- "$self hud window"
  else print -r -- "$self view $1"; fi
}

# up [layout]: build the session from the layout; if it's already there, repair
# it: add the windows the layout has and the session lacks (in the layout's
# order) and the fetch window. Windows are known by @panel_name; nothing is
# removed, reordered or changed.
up() {
  local layout=${1:-$(default_layout)} win w prev="" p id name
  local -a panes added
  local -A have
  [[ -n $layout ]] || die "no layouts in the config"
  [[ -n "$(conf --arg l $layout '.layouts[$l] // empty')" ]] || die "unknown layout: $layout"
  if tmux has-session -t "=$SESSION" 2>/dev/null; then
    tmux list-windows -t "=$SESSION:" -F '#{window_id} #{?@panel_name,#{@panel_name},#{window_name}}' |
      while read -r id name; do have[$name]=$id; done
  fi
  for win in ${(f)"$(conf --arg l $layout '.layouts[$l] | keys_unsorted[]')"}; do
    if [[ -n $have[$win] ]]; then prev=$have[$win]; continue; fi
    panes=( ${(f)"$(conf --arg l $layout --arg w $win '.layouts[$l][$w][]')"} )
    if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
      w="$(tmux new-session -d -s $SESSION -n $win -c ~ -P -F '#{window_id}' "$(pane_cmd $panes[1])")"
    elif [[ -n $prev ]]; then   # right after the window before it in the layout
      w="$(tmux new-window -d -a -t $prev -n $win -c ~ -P -F '#{window_id}' "$(pane_cmd $panes[1])")"
    else                        # the layout's first window: in front
      w="$(tmux new-window -d -b -t "=$SESSION:^" -n $win -c ~ -P -F '#{window_id}' "$(pane_cmd $panes[1])")"
    fi
    (( $#have )) && added+=( $win )
    tmux set-option -w -t $w @panel_name $win
    for p in $panes[2,-1]; do tmux split-window -d -h -t $w -c ~ "$(pane_cmd $p)"; done
    (( $#panes > 1 )) && tmux select-layout -t $w even-horizontal >/dev/null
    prev=$w
  done
  if [[ -z $have[fetch] ]]; then
    w="$(tmux new-window -d -t "=$SESSION:" -n fetch -c ~ -P -F '#{window_id}' "$self fetcher $layout")"
    tmux set-option -w -t $w @panel_name fetch
    (( $#have )) && added+=( fetch )
  fi
  (( $#added )) && print "panel: added ${(j:, :)added}"
  [[ -n $PANEL_DETACHED ]] && return 0
  if [[ -n $TMUX ]]; then tmux switch-client -t "=$SESSION"; else tmux attach -t "=$SESSION"; fi
}

# Commands you run: stop at a missing config, before anything else complains
[[ $1 == (up|fetch|fetcher|view|hud) ]] && conf empty

case $1 in
  up)        if [[ $2 == -d ]]; then PANEL_DETACHED=1 up $3; else up $2; fi ;;
  fetch)     shift; (( $# )) || set -- ${(f)"$(conf '.panes | to_entries[] | select(.value.source) | .key')"}
             for p in $@; do
               if [[ $p == */* ]]; then fetch_pane $p
               else for u in ${(f)"$(pane_units $p)"}; do fetch_pane $u; done; fi
             done ;;
  fetcher)   fetcher $2 ;;
  hud)       if [[ $2 == window ]]; then hud_window; else hud; fi ;;
  view)      [[ -n $2 ]] || die "usage: panel view <pane>"; view $2 ;;
  event)     [[ -n $2 ]] && event $2 </dev/stdin >/dev/null 2>&1; exit 0 ;;
  _lines)    lines $2 $3 ;;
  _prompt)   prompt $2 $3 ;;
  _toggle_find) toggle_find $2 $3 ;;
  _esc)      esc_key $2 $3 ;;
  _reveal)   toggle_reveal $2 $3 ;;
  _find)     find_words $2 $3 "$4" ;;
  _view)     switch_view $2 $3 $4 ;;
  _fetch_now) fetch_pane "$(cur_unit $2 $3)" ;;
  _preview)  preview $2 $3 $4 ;;
  _focus)    on_focus "$(cur_unit $2 $3)" $4 ;;
  _open)     open_url "$(cur_unit $2 $3)" $4 ;;
  _seen_all) u="$(cur_unit $2 $3)"; mark_seen $u ${(f)"$(jq -r '.[].id' "$PANEL_CACHE/panes/$u/items.json")"} ;;
  _unseen)   mark_unseen "$(cur_unit $2 $3)" $4 ;;
  *)         sed -n '2,/^emulate/p' $self | sed -e '$d' -e 's/^# \{0,1\}//'; exit 1 ;;
esac
