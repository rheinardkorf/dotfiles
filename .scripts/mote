#!/usr/bin/env node
// mote: talk to the notify-me mote over USB serial (docs/serial-protocol.md). Zero dependencies.
//
//   mote buzz <alert>              tap | tap2 | tap3 | long | burst | ring | alarm | alarm+
//   mote buzz pattern <a>,<b>,...  alerts in order
//   mote stop                      stop the playing alert and drop the waiting one
//   mote status [--json | --raw]   band link, battery, today's totals, mote health (no band requests)
//   mote connected                 exit 0 if the band is connected, else 1
//   mote port                      the mote's serial port (checked with PING)
//   mote config                    every setting and its value
//   mote config get <key> | set <key> <value>
//   mote config export | import <file>                 all settings as JSON
//   mote history [<dir>]           download the band's raw history packets to <dir>/<stamp>.hex
//   mote watch [<seconds>]         print the mote's events live (Ctrl-C to stop; other commands wait)
//   mote ancs rules                which iPhone notifications buzz, and how
//   mote ancs set app|category <name> <alert|ignore>   add or change a rule
//   mote ancs unset app|category <name>                remove a rule
//   mote ancs default <alert|ignore>                   for notifications no rule matches
//   mote ancs seen                 apps and categories seen since the mote started
//   mote ancs export | import <file>                   all rules as JSON
//   mote chime [on | off | set <enabled|alert|half|hours|days> <value>]   the hourly chime
//   mote alarm [list]              alarms, the next one first
//   mote alarm add <hh:mm> [days <d>] [alert <a>] [label <text>]
//   mote alarm set <id> <time|days|alert|label|enabled> <value> | on <id> | off <id> | rm <id>
//   mote remind [list] [source <s>]                    one-off reminders, soonest first
//   mote remind add <when> [alert <a>] [source <s>] [label <text>]
//   mote remind set <id> <when|alert|label|source> <value> | rm <id> | clear [source <s>]
//   mote remind sync <source> <file>                   replace one source's reminders from JSON
//   mote quiet [on | off | set <enabled|hours|days> <value>]   quiet hours
//   mote snooze [<when> | until <when> | off]          silence everything for a while
//   mote schedule export | import <file>               the mote's schedule as JSON
//   mote reboot
//
// Exit codes: 0 ok, 1 firmware ERR (or not connected), 2 usage, 3 no mote, 4 timeout or port busy.
// Every call first sets the mote's clock from this Mac (TIME). Every call is logged to ~/Library/Logs/notify-me.log. NOTIFY_ME_PORT overrides port detection.
"use strict";

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const tty = require("node:tty");

const ESPRESSIF_VID = 0x303a;
const USB_JTAG_PID = 0x1001;
const PICK_TIMEOUT_MS = 500; // PING per candidate when several Espressif boards are plugged in
const LOG_FILE = path.join(os.homedir(), "Library", "Logs", "notify-me.log");
const LOCK_FILE = path.join(os.tmpdir(), "notify-me.lock");
const LOCK_WAIT_MS = 2000;
const LOCK_STALE_MS = 15000;
const LOCK_TOUCH_MS = 5000; // long requests (history) keep the lock fresh
const HISTORY_DIR = path.join(os.homedir(), "Library", "Application Support", "notify-me", "history");
const DATA_DIR = path.join(os.homedir(), "Library", "Application Support", "notify-me");
const BACKUPS = {
  ancs: path.join(DATA_DIR, "ancs.json"),
  config: path.join(DATA_DIR, "config.json"),
  schedule: path.join(DATA_DIR, "schedule.json"),
};
const HISTORY_TIMEOUT_MS = 120000; // firmware gives up after 12 s of quiet or 90 s of waiting
const SETTLE_MS = 30; // discard stale output buffered before the port was opened
const LIST_TIMEOUT_MS = 5000; // lists and exports read the labels from the mote's flash: ~1 s for a full schedule
const PROTOCOL = /^(OK|ERR|DATA|EVT|LOG)( |$)/;
const ALERTS = ["tap", "tap2", "tap3", "long", "burst", "ring", "alarm", "alarm+"];

class CliError extends Error {
  constructor(code, message) {
    super(message);
    this.exitCode = code;
  }
}

// --- port ------------------------------------------------------------------------------------

// Serial ports of Espressif USB-Serial/JTAG devices. Each USB device is a top-level "+-o" block; the serial port
// path lives inside it.
function parseIoreg(out) {
  const found = [];
  for (const block of out.split(/\n(?=\+-o )/)) {
    const vid = Number(block.match(/"idVendor" = (\d+)/)?.[1]);
    const pid = Number(block.match(/"idProduct" = (\d+)/)?.[1]);
    const callout = block.match(/"IOCalloutDevice" = "([^"]+)"/)?.[1];
    if (vid === ESPRESSIF_VID && pid === USB_JTAG_PID && callout) found.push(callout);
  }
  return found;
}

// No device serial in code: one Espressif board is taken as the mote; with several, the first whose PING answers
// "notify-me" wins. Call inside the lock (it may talk to the ports).
async function findPort() {
  if (process.env.NOTIFY_ME_PORT) return process.env.NOTIFY_ME_PORT;
  // maxBuffer: the default 1 MB is too small when a USB keyboard (e.g. a Moonlander) dumps its HID descriptors
  const out = execFileSync("ioreg", ["-r", "-c", "IOUSBHostDevice", "-l", "-w0"], { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
  const ports = parseIoreg(out);
  if (ports.length === 1) return ports[0];
  for (const port of ports) {
    try {
      const lines = await request(port, "PING", PICK_TIMEOUT_MS);
      if (lines[lines.length - 1].startsWith("OK notify-me")) return port;
    } catch {}
  }
  throw new CliError(3, "notify-me mote not found on USB");
}

// --- lock ------------------------------------------------------------------------------------

async function withLock(fn) {
  const start = Date.now();
  for (;;) {
    try {
      fs.closeSync(fs.openSync(LOCK_FILE, "wx"));
      break;
    } catch (e) {
      if (e.code !== "EEXIST") throw e;
      try {
        if (Date.now() - fs.statSync(LOCK_FILE).mtimeMs > LOCK_STALE_MS) fs.rmSync(LOCK_FILE, { force: true });
      } catch {}
      if (Date.now() - start > LOCK_WAIT_MS) throw new CliError(4, "port busy (another mote command is running)");
      await new Promise((r) => setTimeout(r, 50));
    }
  }
  const now = () => new Date();
  const touch = setInterval(() => {
    try {
      fs.utimesSync(LOCK_FILE, now(), now());
    } catch {}
  }, LOCK_TOUCH_MS);
  try {
    return await fn();
  } finally {
    clearInterval(touch);
    fs.rmSync(LOCK_FILE, { force: true });
  }
}

// --- one request -----------------------------------------------------------------------------

// Collect protocol lines until the terminal OK/ERR line. Non-protocol lines (stale boot text) are skipped.
// onLine (optional) sees each DATA/OK/ERR line as it arrives.
function lineCollector(onDone, onLine = () => {}) {
  let buf = "";
  const lines = [];
  return (chunk) => {
    buf += chunk;
    let i;
    while ((i = buf.indexOf("\n")) >= 0) {
      const line = buf.slice(0, i).replace(/\r$/, "");
      buf = buf.slice(i + 1);
      if (!PROTOCOL.test(line)) continue;
      if (line.startsWith("EVT ") || line.startsWith("LOG ")) continue;
      lines.push(line);
      onLine(line);
      if (/^(OK|ERR)( |$)/.test(line)) return onDone(lines);
    }
  };
}

function openPort(port) {
  let fd;
  try {
    fd = fs.openSync(port, fs.constants.O_RDWR | fs.constants.O_NOCTTY | fs.constants.O_NONBLOCK);
  } catch (e) {
    throw new CliError(3, `can't open ${port}: ${e.code}`);
  }
  const input = new tty.ReadStream(fd);
  input.setRawMode(true);
  const output = new tty.WriteStream(fd);
  const close = () => {
    input.removeAllListeners("data");
    input.destroy();
    output.destroy();
  };
  return { input, output, close };
}

function request(port, line, timeoutMs, onLine) {
  return new Promise((resolve, reject) => {
    let io;
    try {
      io = openPort(port);
    } catch (e) {
      return reject(e);
    }
    const { input, output } = io;
    let sent = false;
    const finish = (err, lines) => {
      clearTimeout(timer);
      io.close();
      err ? reject(err) : resolve(lines);
    };
    const collect = lineCollector((lines) => finish(null, lines), onLine);
    input.on("data", (chunk) => sent && collect(chunk.toString("latin1")));
    const timer = setTimeout(() => finish(new CliError(4, `no reply to ${line.split(" ")[0]} (timeout)`)), timeoutMs);
    setTimeout(() => {
      sent = true;
      output.write(line + "\n");
    }, SETTLE_MS);
  });
}

// Several requests on one opening of the port, each sent once the one before has its reply. Stops at the first ERR;
// returns the replies so far (the last is the ERR, if any).
function requests(port, lines, timeoutMs) {
  return new Promise((resolve, reject) => {
    let io;
    try {
      io = openPort(port);
    } catch (e) {
      return reject(e);
    }
    const { input, output } = io;
    const replies = [];
    let i = -1;
    let timer;
    let collect;
    const finish = (err) => {
      clearTimeout(timer);
      io.close();
      err ? reject(err) : resolve(replies);
    };
    const next = () => {
      i += 1;
      if (i === lines.length) return finish();
      clearTimeout(timer);
      timer = setTimeout(() => finish(new CliError(4, `no reply to ${lines[i].split(" ")[0]} (timeout)`)), timeoutMs);
      collect = lineCollector((got) => {
        replies.push(got);
        got[got.length - 1].startsWith("ERR") ? finish() : next();
      });
      output.write(lines[i] + "\n");
    };
    input.on("data", (chunk) => collect && collect(chunk.toString("latin1")));
    setTimeout(next, SETTLE_MS);
  });
}

function timeLine(d = new Date()) {
  return `TIME ${Math.floor(d.getTime() / 1000)} ${-d.getTimezoneOffset()}`;
}

// The mote decides when the band's clock needs setting, so this is cheap. An ERR (older firmware) is ignored.
async function session(port, line, timeoutMs, onLine) {
  await request(port, timeLine(), 3000);
  return request(port, line, timeoutMs, onLine);
}

async function ask(line, timeoutMs = 2000, onLine) {
  return checked(await withLock(async () => session(await findPort(), line, timeoutMs, onLine)));
}

function checked(lines) {
  const last = lines[lines.length - 1];
  if (last.startsWith("ERR")) {
    const [, code, ...msg] = last.split(" ");
    throw new CliError(1, `${code}: ${msg.join(" ")}`);
  }
  return lines;
}

function fields(okLine) {
  const out = {};
  for (const m of okLine.matchAll(/(\S+)=(\S*)/g)) out[m[1]] = m[2];
  return out;
}

function duration(s) {
  s = Number(s);
  if (s < 60) return `${s}s`;
  if (s < 3600) return `${Math.floor(s / 60)}m`;
  return `${Math.floor(s / 3600)}h${String(Math.floor((s % 3600) / 60)).padStart(2, "0")}m`;
}

const PHONE_HINT = { off: " (mote config set ancs on, then mote reboot)", advertising: " (waiting for the iPhone)" };

function formatStatus(f) {
  const lines = [f.band === "unset" ? "band     not set up: mote config set band.addr <addr>, then mote reboot"
    : `band     ${f.band} for ${duration(f.since)} (${f.addr})`];
  if (f.battery !== "-1") lines.push(`battery  ${f.battery}%`);
  if (f.steps !== "-1") lines.push(`today    ${f.steps} steps, ${f.dist} m, ${f.kcal} kcal`);
  if (f.phone) lines.push(`phone    ${f.phone}${f.phone === "off" ? "" : ` for ${duration(f.phone_since)}`}${PHONE_HINT[f.phone] || ""}`);
  if (f.alarms !== undefined) {
    const n = (count, word) => `${count} ${word}${count === "1" ? "" : "s"}`;
    lines.push(`schedule chime ${f.chime === "1" ? "on" : "off"}, quiet hours ${f.quiet_enabled === "1" ? "on" : "off"}, ` +
      `${n(f.alarms, "alarm")}, ${n(f.reminders, "reminder")}`);
  }
  if (f.quiet === "snooze") lines.push(`quiet    snoozed until ${shortTime(f.quiet_until)}`);
  if (f.quiet === "hours") lines.push(`quiet    quiet hours until ${f.quiet_until}`);
  if (f.time && f.time !== "-") lines.push(`time     ${f.time.replace("T", " ")} ${utcOffset(f.utc_offset)} (from ${f.time_source})`);
  lines.push(`mote     fw ${f.fw}, up ${duration(f.uptime)}, heap ${f.mem_free} B free, ble ${f.idf_free} B free`);
  return lines.join("\n");
}

// "2026-10-13T14:00:00" -> "14:00" today, else "2026-10-14 14:00"
function shortTime(iso, now = new Date()) {
  const p = (n) => String(n).padStart(2, "0");
  const today = `${now.getFullYear()}-${p(now.getMonth() + 1)}-${p(now.getDate())}`;
  return iso.startsWith(today) ? iso.slice(11, 16) : iso.replace("T", " ").slice(0, 16);
}

// 660 -> "UTC+11:00", -330 -> "UTC-05:30"
function utcOffset(minutes) {
  const m = Number(minutes);
  const p = (n) => String(n).padStart(2, "0");
  return `UTC${m < 0 ? "-" : "+"}${p(Math.floor(Math.abs(m) / 60))}:${p(Math.abs(m) % 60)}`;
}

function stamp(d = new Date()) {
  const p = (n) => String(n).padStart(2, "0");
  return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;
}

// Print the mote's EVT/LOG lines as they come, with local times, until Ctrl-C or `seconds` pass. Holds the lock
// meanwhile, so other mote commands (hooks) wait and then fail with exit 4.
async function watch(seconds, print) {
  await withLock(async () => {
    const port = await findPort();
    await request(port, timeLine(), 3000).catch(() => {}); // e.g. still booting: watch anyway
    const io = openPort(port);
    let buf = "";
    io.input.on("data", (chunk) => {
      buf += chunk.toString("latin1");
      let i;
      while ((i = buf.indexOf("\n")) >= 0) {
        const line = buf.slice(0, i).replace(/\r$/, "");
        buf = buf.slice(i + 1);
        if (/^(EVT|LOG) /.test(line)) print(`${new Date().toTimeString().slice(0, 8)} ${line}`);
      }
    });
    await new Promise((resolve) => {
      process.once("SIGINT", resolve);
      if (seconds) setTimeout(resolve, seconds * 1000);
    });
    io.close();
  });
}

// The band clears history once the mote ACKs it, so each packet is written out as soon as it arrives.
// <dir>/<yyyymmdd-hhmmss>.hex: one band packet per line, in hex, as received. Decoding is a separate tool.
async function history(dir, print) {
  await withLock(async () => {
    const port = await findPort(); // before creating anything: exit 3 leaves no empty file
    fs.mkdirSync(dir, { recursive: true });
    const file = path.join(dir, `${stamp()}.hex`);
    const fd = fs.openSync(file, "wx");
    let count = 0;
    try {
      checked(
        await session(port, "HISTORY", HISTORY_TIMEOUT_MS, (line) => {
          if (!line.startsWith("DATA hist ")) return;
          fs.writeSync(fd, line.slice(10) + "\n");
          count++;
        }),
      );
    } finally {
      fs.closeSync(fd);
      if (count === 0) fs.rmSync(file, { force: true });
    }
    print(`${count} packets -> ${file}`);
  });
}

// Typed for scripts; values the mote doesn't know yet (-1 in the firmware line) are null.
function statusJson(f) {
  const num = (v) => (v === undefined || v === "-1" ? null : Number(v));
  const steps = num(f.steps);
  return {
    band: { state: f.band, since_s: num(f.since), addr: f.addr || null, last_data_s: num(f.last_data), battery_pct: num(f.battery) },
    today: steps === null ? null : { steps, dist_m: num(f.dist), kcal: num(f.kcal) },
    phone: f.phone ? { state: f.phone, since_s: num(f.phone_since) } : null,
    chime: f.chime === undefined ? null : { enabled: f.chime === "1" },
    quiet: f.quiet_enabled === undefined ? null : { enabled: f.quiet_enabled === "1" },
    snooze: f.snooze_left === undefined ? null : { remaining_s: num(f.snooze_left) },
    alarm: f.alarms === undefined ? null : { count: num(f.alarms) },
    reminder: f.reminders === undefined ? null : { count: num(f.reminders) },
    mote: {
      fw: f.fw, uptime_s: num(f.uptime), mem_free: num(f.mem_free), idf_free: num(f.idf_free), time_source: f.time_source,
      time: f.time === undefined || f.time === "-" ? null : f.time, utc_offset_min: f.utc_offset === "-" ? null : num(f.utc_offset),
    },
  };
}

// --- ancs rules ------------------------------------------------------------------------------

// DATA rule <default|category|app> ... lines -> aligned text
function formatRules(lines) {
  const rows = lines.filter((l) => l.startsWith("DATA rule ")).map((l) => l.slice(10).split(" "));
  const rule = rows.map((r) => (r[0] === "default" ? ["default", "", r[1]] : r));
  const w0 = Math.max(...rule.map((r) => r[0].length)) + 2;
  const w1 = Math.max(...rule.map((r) => r[1].length)) + 2;
  return rule.map(([kind, name, alert]) => `${kind.padEnd(w0)}${name.padEnd(w1)}${alert}`).join("\n");
}

function formatSeen(lines) {
  const rows = lines.filter((l) => l.startsWith("DATA seen ")).map((l) => l.slice(10).split(" "));
  const overflow = Number(fields(lines[lines.length - 1]).overflow || 0);
  const note = overflow ? `\n(${overflow} more from names that didn't fit: the mote counts ${rows.length} at most)` : "";
  if (!rows.length) return "nothing seen since the mote started" + note;
  const w0 = Math.max(...rows.map((r) => r[0].length)) + 2;
  const w1 = Math.max(...rows.map((r) => r[1].length)) + 2;
  return rows.map(([kind, name, count]) => `${kind.padEnd(w0)}${name.padEnd(w1)}${count.slice(6)}`).join("\n") + note;
}

// The schedule and the ANCS rules travel a line per item (an alarm, a reminder, a rule), so the mote never needs a big
// block of memory for them; files on this Mac stay one JSON document. toLines and fromLines convert.
function toLines(what, doc) {
  if (!doc || typeof doc !== "object" || Array.isArray(doc)) throw new CliError(1, "expected a JSON object");
  const out = [];
  for (const [key, value] of Object.entries(doc)) {
    if (what === "schedule" && (key === "alarms" || key === "reminders")) {
      if (!Array.isArray(value)) throw new CliError(1, `${key} must be a list`);
      for (const item of value) out.push({ [key.slice(0, -1)]: item });
    } else if (what === "ancs" && (key === "app" || key === "category") && value && typeof value === "object" && !Array.isArray(value)) {
      for (const [name, alert] of Object.entries(value)) out.push({ [key]: { [name]: alert } });
    } else out.push({ [key]: value });
  }
  return out;
}

function fromLines(what, values) {
  const out = what === "schedule" ? { chime: {}, alarms: [], reminders: [], quiet: {}, snooze_until: 0 } : { default: "tap", category: {}, app: {} };
  const labels = [];
  for (const value of values) {
    const [[key, v]] = Object.entries(value);
    if (what === "schedule" && (key === "alarm" || key === "reminder")) out[`${key}s`].push({ label: "", ...v });
    else if (what === "schedule" && key === "label") labels.push(v); // the mote sends labels after the items
    else if (what === "ancs" && (key === "app" || key === "category")) Object.assign(out[key], v);
    else out[key] = v;
  }
  for (const { kind, id, label } of labels) {
    const item = out[`${kind}s`].find((x) => x.id === id);
    if (item) item.label = label;
  }
  return out;
}

// <ANCS|CONFIG|SCHEDULE> EXPORT -> one JSON document (config comes as one DATA line, the others a line per item)
async function exported(what) {
  const lines = await ask(`${what.toUpperCase()} EXPORT`, LIST_TIMEOUT_MS);
  if (what === "config") return JSON.parse(lines[0].slice(lines[0].indexOf("{")));
  const prefix = `DATA ${what} `;
  return fromLines(what, lines.filter((l) => l.startsWith(prefix)).map((l) => JSON.parse(l.slice(prefix.length))));
}

// An import a line at a time: the request that starts it, LINE <json> per value, END. Returns the reply to END.
async function sendLines(begin, values) {
  const lines = [begin, ...values.map((v) => `LINE ${JSON.stringify(v)}`), "END"];
  const replies = await withLock(async () => {
    const port = await findPort();
    await request(port, timeLine(), 3000);
    return requests(port, lines, 3000);
  });
  return checked(replies[replies.length - 1]);
}

// After every change: settings and rules live on the mote, so keep a copy on this Mac (import restores it).
async function backup(what, print) {
  try {
    const json = await exported(what);
    fs.mkdirSync(DATA_DIR, { recursive: true });
    fs.writeFileSync(BACKUPS[what], JSON.stringify(json, null, 2) + "\n");
  } catch (e) {
    print(`saved on the mote, but the backup failed: ${e.message}`);
  }
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (e) {
    throw new CliError(1, `can't read ${file}: ${e.message}`);
  }
}

function formatConfig(values) {
  const w = Math.max(...Object.keys(values).map((k) => k.length)) + 2;
  return Object.entries(values).sort(([a], [b]) => a.localeCompare(b)).map(([k, v]) => `${k.padEnd(w)}${v === "" ? "(not set)" : v}`).join("\n");
}

async function ancs(rest, print) {
  const [sub, ...args] = rest;
  const kind = args[0];
  const change = async (line) => {
    const [ok] = await ask(line);
    await backup("ancs", print);
    return ok;
  };
  if (sub === "rules" && args.length === 0) return print(formatRules(await ask("ANCS RULES")));
  if (sub === "seen" && args.length === 0) return print(formatSeen(await ask("ANCS SEEN")));
  if (sub === "export" && args.length === 0) return print(JSON.stringify(await exported("ancs"), null, 2));
  if (sub === "default" && args.length === 1) return void (await change(`ANCS DEFAULT ${args[0]}`));
  if ((kind === "app" || kind === "category") && sub === "set" && args.length === 3) {
    return void (await change(`ANCS SET ${kind} ${args[1]} ${args[2]}`));
  }
  if ((kind === "app" || kind === "category") && sub === "unset" && args.length === 2) {
    const ok = await change(`ANCS UNSET ${kind} ${args[1]}`);
    if (fields(ok).removed === "0") print(`no ${kind} rule for ${args[1]}`);
    return;
  }
  if (sub === "import" && args.length === 1) {
    const [ok] = await sendLines("ANCS IMPORT", toLines("ancs", readJson(args[0])));
    await backup("ancs", print);
    return print(`imported ${fields(ok).rules} rules`);
  }
  throw new CliError(2, USAGE);
}

// --- schedule ---------------------------------------------------------------------------------

function formatChime(f) {
  const next = f.next === "-" ? "-" : f.next.replace("T", " ").slice(0, 16);
  return [`enabled  ${f.enabled === "1" ? "on" : "off"}`, `alert    ${f.alert}`, `half     ${f.half || "off"}`,
    `hours    ${f.hours}`, `days     ${f.days}`, `next     ${next}`].join("\n");
}

async function chime(rest, print) {
  const change = async (line) => {
    await ask(line);
    await backup("schedule", print);
  };
  if (rest.length === 0) return print(formatChime(fields((await ask("CHIME"))[0])));
  if ((rest[0] === "on" || rest[0] === "off") && rest.length === 1) return change(`CHIME ${rest[0]}`);
  if (rest[0] === "set" && rest.length === 3 && ["enabled", "alert", "half", "hours", "days"].includes(rest[1])) {
    return change(`CHIME SET ${rest[1]} ${rest[2]}`);
  }
  throw new CliError(2, USAGE);
}

// DATA alarm id=1 time=07:30 ... next=<iso|-> label=<text, may have spaces>
// Labels stay on the mote's flash and follow the items as "DATA label <kind> <id> <text>" lines; this puts them back.
function labelsOf(lines, kind) {
  const prefix = `DATA label ${kind} `;
  const out = new Map();
  for (const l of lines.filter((x) => x.startsWith(prefix))) {
    const rest = l.slice(prefix.length);
    const space = rest.indexOf(" ");
    out.set(space < 0 ? rest : rest.slice(0, space), space < 0 ? "" : rest.slice(space + 1));
  }
  return out;
}

function parseAlarm(line) {
  const [head, label] = line.slice("DATA alarm ".length).split(/ label=/); // label= from firmware before 0.15
  return { ...fields(head), label: label || "" };
}

function formatAlarms(lines) {
  const labels = labelsOf(lines, "alarm");
  const alarms = lines.filter((l) => l.startsWith("DATA alarm ")).map(parseAlarm).map((a) => ({ ...a, label: labels.get(a.id) ?? a.label }));
  if (!alarms.length) return "no alarms (mote alarm add <hh:mm> [days <d>] [alert <a>] [label <text>])";
  alarms.sort((a, b) => (a.next === "-") - (b.next === "-") || a.next.localeCompare(b.next) || a.id - b.id);
  const rows = [["id", "time", "days", "alert", "on", "next", "label"]].concat(alarms.map((a) => [
    a.id, a.time, a.days, a.alert, a.enabled === "1" ? "on" : "off", a.next === "-" ? "-" : a.next.replace("T", " ").slice(0, 16), a.label]));
  const widths = rows[0].map((_, i) => Math.max(...rows.map((r) => String(r[i]).length)) + 2);
  return rows.map((r) => r.map((c, i) => (i === r.length - 1 ? c : String(c).padEnd(widths[i]))).join("").trimEnd()).join("\n");
}

async function alarm(rest, print) {
  const [sub, ...args] = rest;
  const change = async (line) => {
    const [ok] = await ask(line);
    await backup("schedule", print);
    return ok;
  };
  const id = (s) => {
    if (!/^\d+$/.test(s || "")) throw new CliError(2, USAGE);
    return s;
  };
  if (sub === undefined || (sub === "list" && args.length === 0)) return print(formatAlarms(await ask("ALARM LIST", LIST_TIMEOUT_MS)));
  if (sub === "add" && args.length >= 1) return print(`added alarm ${fields(await change(`ALARM ADD ${args.join(" ")}`)).id}`);
  if (sub === "set" && args.length >= 3) return void (await change(`ALARM SET ${id(args[0])} ${args.slice(1).join(" ")}`));
  if ((sub === "on" || sub === "off" || sub === "rm") && args.length === 1) {
    return void (await change(`ALARM ${sub.toUpperCase()} ${id(args[0])}`));
  }
  throw new CliError(2, USAGE);
}

// --- reminders --------------------------------------------------------------------------------

// <when> -> unix seconds (UTC): "14:30" (the next one), "2026-10-20T09:00" or "2026-10-20 09:00" (local), "25m",
// "1h30m", "90s" (from now). Reminders are instants, so the Mac's time zone is applied here, once.
function parseWhen(text, now = new Date()) {
  let m;
  if ((m = /^(\d{1,2}):(\d{2})$/.exec(text))) {
    const d = new Date(now);
    d.setHours(Number(m[1]), Number(m[2]), 0, 0);
    if (Number(m[1]) > 23 || Number(m[2]) > 59) return null;
    if (d <= now) d.setDate(d.getDate() + 1);
    return Math.floor(d.getTime() / 1000);
  }
  if ((m = /^(\d{4})-(\d{2})-(\d{2})[T ](\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(text))) {
    const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]), Number(m[4]), Number(m[5]), Number(m[6] || 0));
    return Number.isNaN(d.getTime()) || d.getMonth() !== Number(m[2]) - 1 ? null : Math.floor(d.getTime() / 1000);
  }
  if ((m = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(text)) && text) {
    const s = Number(m[1] || 0) * 3600 + Number(m[2] || 0) * 60 + Number(m[3] || 0);
    return s > 0 ? Math.floor(now.getTime() / 1000) + s : null;
  }
  return null;
}

// "2026-10-20 09:00" arrives as two arguments: join a date with the time after it.
function whenArgs(args) {
  if (/^\d{4}-\d{2}-\d{2}$/.test(args[0] || "") && /^\d{1,2}:\d{2}(:\d{2})?$/.test(args[1] || "")) {
    return [`${args[0]} ${args[1]}`, ...args.slice(2)];
  }
  return args;
}

function when(text) {
  const unix = parseWhen(text);
  if (unix === null) throw new CliError(2, `can't read "${text}" as a time: use 14:30, 2026-10-20 09:00, 25m, 1h30m or 90s`);
  return unix;
}

// Time left: 25m, 2h59m, then whole days and hours (6d17h).
function until(s) {
  return s < 86400 ? duration(s) : `${Math.floor(s / 86400)}d${Math.floor((s % 86400) / 3600)}h`;
}

// DATA remind id=1 at=<unix> local=<iso> alert=long source=<s|-> label=<text, may have spaces>
function formatReminders(lines, now = new Date()) {
  const labels = labelsOf(lines, "reminder");
  const items = lines.filter((l) => l.startsWith("DATA remind ")).map((l) => {
    const [head, label] = l.slice("DATA remind ".length).split(/ label=/);
    const r = fields(head);
    return { ...r, label: labels.get(r.id) ?? label ?? "" };
  });
  if (!items.length) return "no reminders (mote remind add <when> [alert <a>] [label <text>])";
  items.sort((a, b) => Number(a.at) - Number(b.at) || Number(a.id) - Number(b.id)); // soonest first
  const p = (n) => String(n).padStart(2, "0");
  const local = (unix) => {
    const d = new Date(unix * 1000);
    const secs = d.getSeconds() ? `:${p(d.getSeconds())}` : ""; // timers set in seconds keep them
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}${secs}`;
  };
  const rows = [["id", "when", "in", "alert", "source", "label"]].concat(items.map((r) => [
    r.id, local(Number(r.at)), until(Math.max(0, Number(r.at) - Math.floor(now.getTime() / 1000))), r.alert, r.source, r.label]));
  const widths = rows[0].map((_, i) => Math.max(...rows.map((r) => String(r[i]).length)) + 2);
  return rows.map((r) => r.map((c, i) => (i === r.length - 1 ? c : String(c).padEnd(widths[i]))).join("").trimEnd()).join("\n");
}

// A sync file: [{"at": <unix seconds | "2026-10-20T09:00" (local) | ISO with a zone>, "alert"?, "label"?}, ...]
function syncItems(file) {
  const items = readJson(file);
  if (!Array.isArray(items)) throw new CliError(1, `${file}: expected a JSON array of {at, alert, label}`);
  return items.map((item, i) => {
    let at = item && item.at;
    if (typeof at === "string") {
      const unix = /[zZ]|[+-]\d{2}:?\d{2}$/.test(at) ? Math.floor(Date.parse(at) / 1000) : parseWhen(at.replace(" ", "T"));
      if (!Number.isFinite(unix)) throw new CliError(1, `${file}: item ${i + 1}: can't read "${at}" as a time`);
      at = unix;
    }
    return { ...item, at };
  });
}

async function remind(rest, print) {
  const [sub, ...rawArgs] = rest;
  const args = whenArgs(rawArgs);
  const change = async (line) => {
    const [ok] = await ask(line);
    await backup("schedule", print);
    return ok;
  };
  const id = (s) => {
    if (!/^\d+$/.test(s || "")) throw new CliError(2, USAGE);
    return s;
  };
  const sourceOnly = (a) => {
    if (a.length === 0) return "";
    if (a.length === 2 && a[0] === "source") return ` source ${a[1]}`;
    throw new CliError(2, USAGE);
  };
  if (sub === undefined || sub === "list") return print(formatReminders(await ask(`REMIND LIST${sourceOnly(rawArgs)}`, LIST_TIMEOUT_MS)));
  if (sub === "add" && args.length >= 1) {
    const ok = await change(`REMIND ADD ${when(args[0])}${args.length > 1 ? " " + args.slice(1).join(" ") : ""}`);
    return print(`added reminder ${fields(ok).id}`);
  }
  if (sub === "set" && rawArgs.length >= 3) {
    const [rid, key, ...value] = rawArgs;
    const v = key === "when" ? String(when(whenArgs(value)[0])) : value.join(" ");
    return void (await change(`REMIND SET ${id(rid)} ${key === "when" ? "at" : key} ${v}`));
  }
  if (sub === "rm" && rawArgs.length === 1) return void (await change(`REMIND RM ${id(rawArgs[0])}`));
  if (sub === "clear") return print(`removed ${fields(await change(`REMIND CLEAR${sourceOnly(rawArgs)}`)).removed}`);
  if (sub === "sync" && rawArgs.length === 2) {
    const [ok] = await sendLines(`REMIND SYNC ${rawArgs[0]}`, syncItems(rawArgs[1]));
    await backup("schedule", print);
    return print(`${fields(ok).source}: ${fields(ok).reminders} reminders`);
  }
  throw new CliError(2, USAGE);
}

// --- quiet hours and snooze -------------------------------------------------------------------

function formatQuiet(f) {
  return [`enabled  ${f.enabled === "1" ? "on" : "off"}`, `hours    ${f.hours}`, `days     ${f.days}`,
    `now      ${f.active === "1" ? "quiet" : "not quiet"}`].join("\n");
}

async function quiet(rest, print) {
  const change = async (line) => {
    await ask(line);
    await backup("schedule", print);
  };
  if (rest.length === 0) return print(formatQuiet(fields((await ask("QUIET"))[0])));
  if ((rest[0] === "on" || rest[0] === "off") && rest.length === 1) return change(`QUIET ${rest[0]}`);
  if (rest[0] === "set" && rest.length === 3 && ["enabled", "hours", "days"].includes(rest[1])) {
    return change(`QUIET SET ${rest[1]} ${rest[2]}`);
  }
  throw new CliError(2, USAGE);
}

async function snooze(rest, print) {
  const show = (ok) => {
    const f = fields(ok);
    return print(f.until === "-" ? "not snoozed" : `snoozed until ${shortTime(f.until)} (${duration(f.left)} left)`);
  };
  if (rest.length === 0) return show((await ask("SNOOZE"))[0]);
  if (rest.length === 1 && rest[0] === "off") return show((await ask("SNOOZE OFF"))[0]);
  const args = whenArgs(rest[0] === "until" ? rest.slice(1) : rest);
  if (args.length !== 1) throw new CliError(2, USAGE);
  return show((await ask(`SNOOZE ${when(args[0])}`))[0]);
}

async function schedule(rest, print) {
  if (rest[0] === "export" && rest.length === 1) return print(JSON.stringify(await exported("schedule"), null, 2));
  if (rest[0] === "import" && rest.length === 2) {
    await sendLines("SCHEDULE IMPORT", toLines("schedule", readJson(rest[1])));
    await backup("schedule", print);
    return print("imported");
  }
  throw new CliError(2, USAGE);
}

// --- commands --------------------------------------------------------------------------------

const USAGE = `usage: mote <command> [args]   (mote help for details)
  buzz <alert> | buzz pattern <a>,<b>,... | stop | status [--json|--raw] | connected | port | watch [<s>]
  history [<dir>] | config [get <key> | set <key> <value> | export | import <file>] | reboot
  ancs rules | ancs set app|category <name> <alert|ignore> | ancs unset app|category <name>
  ancs default <alert|ignore> | ancs seen | ancs export | ancs import <file>
  chime | chime on|off | chime set <enabled|alert|half|hours|days> <value> | schedule export | schedule import <file>
  alarm [list] | alarm add <hh:mm> [days <d>] [alert <a>] [label <text>] | alarm set <id> <key> <value>
  alarm on|off|rm <id>
  remind [list] [source <s>] | remind add <when> [alert <a>] [source <s>] [label <text>]
  remind set <id> <when|alert|label|source> <value> | remind rm <id> | remind clear [source <s>]
  remind sync <source> <file> | quiet | quiet on|off | quiet set <enabled|hours|days> <value>
  snooze | snooze <when> | snooze until <when> | snooze off`;

const HELP = `mote: talk to the notify-me mote (the ESP32 in front of your fitness band) over USB.

BUZZ THE BAND
  mote buzz <alert>              play an alert on the band
  mote buzz pattern <a>,<b>,...  several alerts in order, 6 s apart
  mote stop                      stop the playing alert and drop the waiting one

  alerts: tap tap2 tap3 long burst ring alarm alarm+
  One alert plays at a time and one more can wait (a newer one replaces it).

CHECK ON IT
  mote status                    band, battery, today's steps, iPhone link, the mote's time, mote health
  mote status --json             the same as JSON, for scripts (unknown values are null)
  mote connected                 exit 0 if the band is connected, else 1 (for scripts and hooks)
  mote watch [<seconds>]         print the mote's events live: links, notifications, battery (Ctrl-C to stop;
                                 other mote commands get "port busy" meanwhile)
  mote port                      which serial port the mote is on

IPHONE NOTIFICATIONS
  Which notifications buzz, and how. Each rule matches an app or a category and names an alert, or "ignore".
  An app rule beats a category rule, which beats the default. Changes apply at once.

  mote ancs rules                list the rules
  mote ancs set app <bundle id> <alert|ignore>
  mote ancs set category <category> <alert|ignore>
  mote ancs unset app|category <name>
  mote ancs default <alert|ignore>         for notifications no rule matches ("ignore" = only rules buzz)
  mote ancs seen                 apps and categories seen since the mote started (to find bundle ids)
  mote ancs export               all rules as JSON
  mote ancs import <file>        replace all rules from a JSON file

  categories: other incoming_call missed_call voicemail social schedule email news health business location
              entertainment

  e.g.  mote ancs set app com.duolingo.DuolingoMobile ignore
        mote ancs set category missed_call ignore

HOURLY CHIME
  An alert at the top of each hour inside the active hours and days, played by the mote itself (so it keeps
  going while the Mac sleeps). It needs the time: after the mote restarts, any mote command sets it.

  mote chime                     settings and the next chime
  mote chime set enabled on|off  default off (mote chime on|off for short)
  mote chime set alert <alert>   default tap2
  mote chime set half <alert|off>   also at each half hour between the first and last chime (hours 09-17:
                                 09:30 through 16:30); default off
  mote chime set hours <hh-hh>   e.g. 09-17: chimes at 09:00 through 17:00 (default)
  mote chime set days <days>     e.g. mon-fri (default), mon,wed,fri, sat-sun, every

ALARMS
  Played by the mote at a time of day, like the chime (it needs the time; a missed one is never played late).
  The band's button can't stop an alert: alarm+ is the strongest, and mote stop cuts one short.

  mote alarm                     list alarms, the next one first
  mote alarm add <hh:mm> [days <days>] [alert <alert>] [label <text>]
                                 days: every (default), mon-fri, mon,wed,fri, ... or once (rings at the next
                                 <hh:mm>, then switches itself off); alert: default alarm; label: up to 32
                                 characters, may have spaces (keep it last)
  mote alarm set <id> <time|days|alert|label|enabled> <value>
  mote alarm on | off <id>
  mote alarm rm <id>

  e.g.  mote alarm add 07:30 days mon-fri alert alarm+ label stand-up

REMINDERS
  One-off buzzes at a moment in time, from you or any script (e.g. a calendar export). Unlike alarms they are fixed
  instants (UTC): changing time zone doesn't move them. Each one is deleted once played or missed. Anything due at
  the same time (reminders, alarms, the chime) plays as one buzz, with the strongest alert among them.

  mote remind                    list reminders, soonest first (mote remind list source <s>: one source's)
  mote remind add <when> [alert <alert>] [source <source>] [label <text>]
                                 when: 14:30 (the next one), 2026-10-20 09:00, or from now: 25m, 1h30m, 90s
                                 (a timer: rings within a second); alert: default long; label last (may have spaces)
  mote remind set <id> <when|alert|label|source> <value>
  mote remind rm <id>
  mote remind clear [source <source>]      all reminders, or one source's
  mote remind sync <source> <file>         replace all of one source's reminders at once (for scripts):
                                 [{"at": "2026-10-20T09:00", "label": "standup"}, ...]; at may also be unix
                                 seconds or ISO with a zone; past ones are dropped

  e.g.  mote remind add 25m label tea
        mote remind add 90s alert tap3                 # a timer
        mote remind add 2026-10-20 09:55 alert tap3 source work-cal label standup

QUIET HOURS AND SNOOZE
  Silenced buzzes are dropped, not saved for later.

  quiet hours (default off, 22:00-07:00, every day) silence the chime, iPhone notifications and mote buzz (hooks);
  calls, alarms and reminders still come through.
  mote quiet                     settings and whether it's quiet now
  mote quiet on | off            (mote quiet set enabled on|off)
  mote quiet set hours <hh:mm-hh:mm>       may cross midnight: 22:00-07:00 belongs to the day it starts
  mote quiet set days <days>     e.g. every, mon-fri, fri,sat

  a snooze silences everything, calls, alarms and reminders included (they are used up, not delayed):
  mote snooze <when>             until then: 45m, 2h, 14:00 (also: mote snooze until 14:00)
  mote snooze off
  mote snooze                    how long is left

  mote schedule export           the whole schedule (chime, alarms, reminders, quiet hours, snooze) as JSON
  mote schedule import <file>    replace it from a JSON file

SETTINGS (apply after mote reboot)
  mote config                    every setting and its value
  mote config get <key>
  mote config set <key> <value>  band.addr <aa:bb:cc:dd:ee:ff>   the band to connect to
                                 watchdog on|off                 restart the mote if it hangs
                                 ancs on|off                     the iPhone link
  mote config export             all settings as JSON
  mote config import <file>      replace all settings from a JSON file

DATA AND UPKEEP
  mote history [<dir>]           download the band's stored history as raw packets, one file per download
                                 (default ~/Library/Application Support/notify-me/history/)
  mote reboot                    restart the mote

FILES
  Settings and rules live on the mote. After every change the CLI saves a copy in
  ~/Library/Application Support/notify-me/ (config.json, ancs.json, schedule.json); restore with
  config/ancs/schedule import.
  Every call is logged to ~/Library/Logs/notify-me.log.

Every call also sets the mote's clock from this Mac. NOTIFY_ME_PORT=<port> skips port detection.
Exit codes: 0 ok, 1 the mote said no (or the band isn't connected), 2 usage, 3 no mote, 4 timeout or port busy.`;

async function run(argv, print = console.log) {
  const [cmd, ...rest] = argv;
  switch (cmd) {
    case undefined:
    case "help":
    case "-h":
    case "--help":
      return print(HELP);
    case "buzz": {
      if (rest[0] === "pattern" && rest.length === 2) return void (await ask(`PATTERN ${rest[1]}`));
      if (rest.length !== 1) throw new CliError(2, USAGE);
      return void (await ask(`BUZZ ${rest[0]}`));
    }
    case "stop":
      return void (await ask("STOP"));
    case "status": {
      const [ok] = await ask("STATUS");
      if (rest.includes("--raw")) return print(ok.slice(3));
      if (rest.includes("--json")) return print(JSON.stringify(statusJson(fields(ok)), null, 2));
      return print(formatStatus(fields(ok)));
    }
    case "connected": {
      const [ok] = await ask("STATUS");
      if (fields(ok).band !== "connected") throw new CliError(1, "");
      return;
    }
    case "port":
      return print(
        await withLock(async () => {
          const port = await findPort();
          checked(await request(port, "PING", 2000));
          return port;
        }),
      );
    case "config": {
      if (rest.length === 0) return print(formatConfig(await exported("config")));
      if (rest[0] === "export" && rest.length === 1) return print(JSON.stringify(await exported("config"), null, 2));
      if (rest[0] === "import" && rest.length === 2) {
        await ask(`CONFIG IMPORT ${JSON.stringify(readJson(rest[1]))}`);
        await backup("config", print);
        return print("imported; takes effect after: mote reboot");
      }
      if (rest[0] === "get" && rest.length === 2) {
        const [ok] = await ask(`CONFIG GET ${rest[1]}`);
        return print(ok.slice(3).split("=").slice(1).join("="));
      }
      if (rest[0] === "set" && rest.length === 3) {
        await ask(`CONFIG SET ${rest[1]} ${rest[2]}`);
        await backup("config", print);
        return print("saved; takes effect after: mote reboot");
      }
      throw new CliError(2, USAGE);
    }
    case "watch":
      if (rest.length > 1 || (rest[0] && !/^\d+$/.test(rest[0]))) throw new CliError(2, USAGE);
      return watch(Number(rest[0] || 0), print);
    case "history":
      if (rest.length > 1) throw new CliError(2, USAGE);
      return history(rest[0] || HISTORY_DIR, print);
    case "ancs":
      return ancs(rest, print);
    case "chime":
      return chime(rest, print);
    case "schedule":
      return schedule(rest, print);
    case "alarm":
      return alarm(rest, print);
    case "remind":
      return remind(rest, print);
    case "quiet":
      return quiet(rest, print);
    case "snooze":
      return snooze(rest, print);
    case "reboot":
      return void (await ask("REBOOT"));
    default:
      throw new CliError(2, USAGE);
  }
}

function logLine(args, outcome, ms) {
  try {
    fs.mkdirSync(path.dirname(LOG_FILE), { recursive: true });
    const d = new Date();
    const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 19);
    fs.appendFileSync(LOG_FILE, `${local} mote ${args.join(" ")} -> ${outcome} (${ms} ms)\n`);
  } catch {}
}

async function main() {
  const args = process.argv.slice(2);
  const t0 = Date.now();
  try {
    await run(args);
    logLine(args, "ok", Date.now() - t0);
  } catch (e) {
    const code = e instanceof CliError ? e.exitCode : 4;
    if (e.message) console.error(code === 2 ? e.message : `mote: ${e.message}`);
    logLine(args, `exit ${code} ${e.message.split("\n")[0]}`, Date.now() - t0);
    process.exitCode = code;
  }
}

if (require.main === module) main();
