#!/usr/bin/env zsh
# Open the panel session from anywhere (Hammerspoon: hyper+p), kitty open or not.
#
# Builds or repairs the session (panel up -d), then switches the most recently
# used tmux client to it and brings kitty forward; with no tmux client (or no
# kitty), opens a kitty window attached to it.
emulate -L zsh
path=(/opt/homebrew/bin $path)

~/.scripts/panel up -d >/dev/null 2>&1 || { print -u2 "panel-open: panel up failed"; exit 1 }
client="$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | awk 'NR == 1 { print $2 }')"
if [[ -n $client ]] && pgrep -xq kitty; then
  tmux switch-client -c "$client" -t "=panel"
  open -a kitty
else
  open -na kitty --args /opt/homebrew/bin/tmux attach -t "=panel"
fi
