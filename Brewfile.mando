brew "gnutls"
brew "gpac"
brew "haskell-stack"
brew "imagemagick"
brew "joplin-cli"
brew "ldns"
brew "leptonica"
brew "lftp"
brew "libass"
brew "librist"
brew "libslirp"
brew "luarocks"
brew "mlx"
brew "mlx-lm"
brew "mosquitto"
brew "mpv"
brew "mysql"
brew "ncdu"
brew "tree-sitter"
brew "nmap"
brew "opencascade"
brew "tesseract"
