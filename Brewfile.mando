# Extra packages for mando (personal Mac), on top of Brewfile.core.
# bootstrap.sh installs whatever is missing from Brewfile.<machine-name>, never upgrading.
# Only brew/cask entries; npm/go globals and VS Code extensions are managed elsewhere.

tap "antoniorodr/memo"
tap "aws/tap", trusted: true
tap "bionus/imgbrd-grabber", "https://github.com/Bionus/homebrew-imgbrd-grabber"
tap "candid82/brew", trusted: true
tap "espanso/espanso", trusted: true
tap "felixkratz/formulae"
tap "freecad/freecad", trusted: true
tap "fsouza/prettierd"
tap "hashicorp/tap", trusted: true
tap "localstack/tap"
tap "mickeyl/formulae", trusted: true
tap "mongodb/brew"
tap "nikitabobko/tap"
tap "pebble/pebble-sdk", trusted: true
tap "rcmdnk/file"
tap "yqrashawn/goku"

brew "aom"
brew "openssl@3"
brew "arp-scan"
brew "autoconf"
brew "python@3.14"
brew "aws-sam-cli"
brew "libssh2"
brew "bento4"
brew "cairo"
brew "gcc"
brew "suite-sparse"
brew "hdf5"
brew "libtiff"
brew "harfbuzz"
brew "webp"
brew "jpeg-xl"
