brew "tcl-tk"
brew "qemu"
brew "qt"
brew "rustup"
brew "tailwindcss"
brew "taplo"
brew "telnet"
brew "tor"
brew "torsocks"
brew "unbound"
brew "winetricks"
brew "zsh"
brew "antoniorodr/memo/memo", trusted: true
brew "fsouza/prettierd/prettierd", trusted: true
brew "localstack/tap/localstack-cli", trusted: true
brew "mongodb/brew/mongodb-database-tools", trusted: true
brew "rcmdnk/file/brew-file", trusted: true
