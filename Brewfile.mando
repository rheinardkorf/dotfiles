# Extra packages for mando (personal Mac), on top of Brewfile.core.
# bootstrap.sh installs whatever is missing from Brewfile.<machine-name>, never upgrading.
# Only brew/cask entries; npm/go globals and VS Code extensions are managed elsewhere.

tap "mongodb/brew"

brew "arp-scan"
brew "aws-sam-cli"
brew "bento4"
brew "gcc"
brew "cmake"
brew "cocoapods"
brew "php"
brew "composer"
brew "e2fsprogs"
brew "esphome"
brew "exiftool"
brew "ffmpeg"
brew "gamdl"
brew "gpac"
brew "imagemagick"
brew "joplin-cli"
brew "ldns"
brew "lftp"
brew "libslirp"
brew "mlx"
brew "mlx-lm"
brew "mosquitto"
brew "mpv"
brew "mysql"
brew "nmap"
brew "tesseract"
brew "openjdk@17"
brew "podman"
brew "python@3.11"
brew "qemu"
brew "taplo"
brew "telnet"
brew "tor"
brew "torsocks"
brew "mongodb/brew/mongodb-database-tools", trusted: true

cask "aldente"
cask "elgato-stream-deck"
cask "evernote"
cask "flutter"
cask "font-sf-pro"
cask "google-chrome"
cask "karabiner-elements"
cask "keycastr"
cask "live-home-3d"
cask "mqttx"
cask "ngrok"
cask "openzfs"
cask "podman-desktop"
cask "postman"
cask "sf-symbols"
cask "steam"
cask "the-unarchiver"
cask "tor-browser"
cask "tunnelblick"
cask "visual-studio-code"
cask "vlc"
